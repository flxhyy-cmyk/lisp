;; ================================================================
;; 二、小工具
;; ================================================================

;; 去首尾半角空格（只切 ASCII 空格，不会切坏中文）
(defun pgt:trim (s / n)
  (setq s (if s s ""))
  (while (and (> (strlen s) 0) (= 32 (ascii (substr s 1 1))))
    (setq s (substr s 2))
  )
  (setq n (strlen s))
  (while (and (> n 0) (= 32 (ascii (substr s n 1))))
    (setq s (substr s 1 (1- n)) n (1- n))
  )
  s
)

;; "AH01,AH02 AH03" -> ("AH01" "AH02" "AH03")
;; 按字节逐个走：中文柜号被切成单字节再拼回去，字节序列不变，结果正确
(defun pgt:split (s / res cur i n ch)
  (setq res nil cur "" s (pgt:trim (if s s "")) n (strlen s) i 1)
  (while (<= i n)
    (setq ch (substr s i 1))
    (if (member ch (list "," " " (chr 9) ";" (chr 10)))
      (progn (if (/= cur "") (setq res (cons cur res))) (setq cur ""))
      (setq cur (strcat cur ch))
    )
    (setq i (1+ i))
  )
  (if (/= cur "") (setq res (cons cur res)))
  (reverse res)
)

;; 向上取整 a/b（整数相除前先转实数 —— AutoLISP 的 / 对整数是整除）
(defun pgt:ceil (a b)
  (fix (/ (+ a (1- b)) (float b)))
)

;; 块定义是否存在
(defun pgt:defp (bn)
  (if (tblobjname "BLOCK" bn) T nil)
)

;; 量块定义内部几何范围 -> (minx miny maxx maxy)；块内实体坐标是相对基点的
;; 不用 COM 包围盒：LISP 侧拿到的是 safearray 不是 variant，容易炸
(defun pgt:rng (bn / e ed x q minx miny maxx maxy)
  (setq e (tblobjname "BLOCK" bn))
  (if (null e)
    nil
    (progn
      (setq e (entnext e) minx 1e9 miny 1e9 maxx -1e9 maxy -1e9)
      (while (and e (/= "ENDBLK" (cdr (assoc 0 (entget e)))))
        (setq ed (entget e))
        (foreach x ed
          (setq q (cdr x))
          (if (and (member (car x) (list 10 11)) (listp q))
            (progn
              (if (< (car q) minx) (setq minx (car q)))
              (if (< (cadr q) miny) (setq miny (cadr q)))
              (if (> (car q) maxx) (setq maxx (car q)))
              (if (> (cadr q) maxy) (setq maxy (cadr q)))
            )
          )
        )
        (setq e (entnext e))
      )
      (list minx miny maxx maxy)
    )
  )
)

;; 图框模版定义里的「锚块」：那个匿名块参照（名以 * 开头），
;; 它的位置就是框左下角相对基点的偏移。返回 (块名 锚点x 锚点y)
(defun pgt:fanchor ( / e ed bn p r)
  (setq e (tblobjname "BLOCK" "图框模版") r nil)
  (if e
    (progn
      (setq e (entnext e))
      (while (and e (/= "ENDBLK" (cdr (assoc 0 (entget e)))))
        (setq ed (entget e))
        (if (= "INSERT" (cdr (assoc 0 ed)))
          (progn
            (setq bn (cdr (assoc 2 ed)) p (cdr (assoc 10 ed)))
            (if (and bn p (= "*" (substr bn 1 1)))
              (setq r (list bn (car p) (cadr p)))
            )
          )
        )
        (setq e (entnext e))
      )
    )
  )
  r
)

;; 取 GKC 回包里 "|标记值|" 的那一段（标记是 ASCII）
;; 注意：一律用 gkc:bfind 定位 —— 它按字节回 1 基下标，配 substr 不会错位
(defun pgt:kv (s key / p q)
  (setq p (gkc:bfind s key))
  (if p
    (progn
      (setq p (+ p (strlen key)))
      (setq q (gkc:bfind (substr s p) "|"))
      (substr s p (if q (1- q) 9999))
    )
    nil
  )
)

;; 从 "@defs=旧>新;旧>新;" 里找指定旧名对应的新名
(defun pgt:newdef (s obn / r p q seg)
  (setq r nil s (if s s ""))
  (while (setq p (gkc:bfind s ";"))
    (setq seg (substr s 1 (1- p)) s (substr s (1+ p)))
    (setq q (gkc:bfind seg ">"))
    (if (and q (= obn (substr seg 1 (1- q))))
      (setq r (substr seg (1+ q)))
    )
  )
  (if (> (strlen s) 0)
    (progn
      (setq q (gkc:bfind s ">"))
      (if (and q (= obn (substr s 1 (1- q))))
        (setq r (substr s (1+ q)))
      )
    )
  )
  r
)

;; 删掉 *pgt:far* 附近的块参照（±500）—— 造副本定义留下的临时件
;; 注意：用「区间」而不是「大于」：正式图起点万一摆得很大，按 > 判会误删
(defun pgt:purgef (c / ss n i e ed p cnt lo hi)
  (setq ss (ssget "_X" '((0 . "INSERT") (410 . "Model")))
        n (if ss (sslength ss) 0) i 0 cnt 0
        lo (- c 500.0) hi (+ c 500.0))
  (while (< i n)
    (setq e (ssname ss i) ed (entget e) p (cdr (assoc 10 ed)))
    (if (and p (> (car p) lo) (< (car p) hi))
      (progn (entdel e) (setq cnt (1+ cnt)))
    )
    (setq i (1+ i))
  )
  cnt
)

;; ================================================================
;; 三、插块（全走 COM）
;; ================================================================
;; 为什么不用 (command "_.-INSERT" …) 插正式块：见文件头。COM 不问任何东西。
;; 变体 / 安全数组 -> 普通表（COM 在 LISP 侧两种都可能吐出来）
(defun pgt:aslist (r / v)
  (cond
    ((= (type r) 'safearray)
     (setq v (vl-catch-all-apply 'vlax-safearray->list (list r)))
     (if (vl-catch-all-error-p v) nil v))
    ((= (type r) 'variant)
     (setq v (vl-catch-all-apply 'vlax-variant-value (list r)))
     (if (vl-catch-all-error-p v)
       nil
       (if (= (type v) 'safearray)
         (progn
           (setq v (vl-catch-all-apply 'vlax-safearray->list (list v)))
           (if (vl-catch-all-error-p v) nil v))
         nil)))
    ((listp r) r)
    (T nil)
  )
)

;; 当前文档的模型空间（COM），拿不到返回 nil
(defun pgt:ms ( / app d)
  (setq app (vl-catch-all-apply 'vlax-get-acad-object nil))
  (if (vl-catch-all-error-p app)
    nil
    (progn
      (setq d (vl-catch-all-apply 'vla-get-ActiveDocument (list app)))
      (if (vl-catch-all-error-p d)
        nil
        (progn
          (setq d (vl-catch-all-apply 'vla-get-ModelSpace (list d)))
          (if (vl-catch-all-error-p d) nil d)
        )
      )
    )
  )
)

;; 插一个块参照（按块名，块定义必须已在本图）-> VLA 对象；失败 nil
;; 先按 6 参（x y z 比例 + 转角），不行再退 5 参（x y 比例 + 转角）——
;;   不同版本的 InsertBlock 签名不一样，两条都试一次比赌一条稳
(defun pgt:ins (bn pt / ms p r)
  (setq ms (pgt:ms))
  (if (null ms)
    nil
    (progn
      (setq p (vlax-3d-point (car pt) (cadr pt) 0.0))
      ;; 必须走直连包装 vla-InsertBlock，6 参：插入点 + 块名 + x y z 比例 + 转角
      ;;   vlax-invoke 那条路在本机不通（实测 2026-09-20）：
      ;;     6 参回「发生意外。」，5 参回「无效的参数数目。」
      ;;     —— 和当初 vlax-invoke 'Move 报「发生意外」是同一类毛病
      ;;   插入点也必须用 vlax-3d-point：传普通表会回
      ;;     「此类型的 LISP 值不能强制转换成 VARIANT」
      (setq r (vl-catch-all-apply 'vla-InsertBlock
                (list ms p bn 1.0 1.0 1.0 0.0)))
      (if (vl-catch-all-error-p r) (setq r nil))
      r
    )
  )
)

;; 命令行 -INSERT，只用来把「模板 dwg 文件」带进本图（按路径插，插完就删）
;;   COM 的 InsertBlock 不吃文件路径（server.py 8693 记过这条），所以这里
;;   是全文唯一保留命令行插块的地方 —— 这条路实测是通的（临时件不带属性值）。
(defun pgt:insf (path pt / before e oa)
  (setq before (entlast))
  (setq oa (getvar "ATTREQ"))
  (setvar "ATTREQ" 0)
  (command "_.-INSERT" (strcat "\"" path "\"") pt 1 1 0)
  (setvar "ATTREQ" oa)
  (setq e (entlast))
  (if (equal e before) nil e)
)

;; 炸开一层（COM）+ 删源对象：COM 的 Explode 不像 EXPLODE 命令那样删源
(defun pgt:exp (ref / r)
  (if ref
    (progn
      (setq r (vl-catch-all-apply 'vla-Explode (list ref)))
      (if (vl-catch-all-error-p r) (setq r nil))
      (vl-catch-all-apply 'vla-Delete (list ref))
      (pgt:aslist r)
    )
  )
)

;; 写属性值（按标签精确定位，只改这一个）
(defun pgt:setatt (ref tg val / lst a tgv)
  (if ref
    (progn
      (setq lst (pgt:aslist (vl-catch-all-apply 'vla-GetAttributes
                               (list ref))))
      (foreach a lst
        (if (= (type a) 'VLA-OBJECT)
          (progn
            (setq tgv (vl-catch-all-apply 'vla-get-TagString (list a)))
            (if (and (not (vl-catch-all-error-p tgv)) (= tg tgv))
              (vl-catch-all-apply 'vla-put-TextString (list a val))
            )
          )
        )
      )
    )
  )
  val
)

;; 把模板 dwg 的块定义带进本图（已经有就不动它）；成了返回 T
(defun pgt:import (dwg bn / f e)
  (if (pgt:defp bn)
    T
    (progn
      (setq f (pgt:tpl dwg))
      (if (null f)
        nil
        (progn
          (setq e (pgt:insf f (list *pgt:far* 0.0)))
          (if e (entdel e))
          (pgt:defp bn)
        )
      )
    )
  )
)

;; ================================================================
;; 四、定槽：拿到「槽数 = n」的柜块 / 表头块定义名
;; ================================================================
;; 模板是固定槽数的。用户要别的槽数时，在远地插一对（1 表头 + 1 柜），
;; 调一次 gkc:expand 让整排变成 n 槽，记下新定义名，再把临时参照删掉。
;; 这样「调槽」整张图只发生一次，正式铺图直接用现成的定义。
;; 返回 (柜块名 表头块名 实际槽数)
;; 注意：临时件摆成「相邻」（表头在 20000、柜块在 20040，表头宽正好 40），
;;   gkc:rowfill 才会按几何把它们判成同一排，一起 ±k；分开摆会只变一半。
(defun pgt:defs (n cab0 hdr0 / cur r e1 e2 h1 h2 nc nh)
  (setq cur (gkc:maxslot cab0))
  (if (or (null n) (<= n 0) (null cur) (= cur n))
    (list cab0 hdr0 cur)
    (progn
      (setq e1 (pgt:ins hdr0 (list *pgt:far* 0.0)))
      (setq e2 (pgt:ins cab0 (list (+ *pgt:far* 40.0) 0.0)))
      (if (or (null e1) (null e2))
        (list cab0 hdr0 cur)
        (progn
          (setq h1 (vl-catch-all-apply 'vla-get-Handle (list e1)))
          (setq h2 (vl-catch-all-apply 'vla-get-Handle (list e2)))
          (if (or (vl-catch-all-error-p h1) (vl-catch-all-error-p h2))
            (progn (pgt:purgef *pgt:far*) (list cab0 hdr0 cur))
            (progn
              (setq r (gkc:expand (strcat h1 "," h2) (- n cur)))
              (setq nc (pgt:newdef (pgt:kv r "@defs=") cab0))
              (setq nh (pgt:newdef (pgt:kv r "@defs=") hdr0))
              (pgt:purgef *pgt:far*)
              (if (and nc nh)
                (list nc nh n)
                (list cab0 hdr0 cur)
              )
            )
          )
        )
      )
    )
  )
)

;; 清掉上轮未引用的克隆定义（柜块模版-排* / 表头块模版-表头*），腾干净名字。
;; 被引用的 -PURGE 会自己拒绝。返回清掉几个。与 xbt:purgeold 同口径。
(defun pgt:purgeold ( / b nm lst k ce)
  (setq b (tblnext "BLOCK" T) lst nil)
  (while b
    (setq nm (cdr (assoc 2 b)))
    (if (and (/= nm "") (wcmatch nm "柜块模版-排*,表头块模版-表头*"))
      (setq lst (cons nm lst))
    )
    (setq b (tblnext "BLOCK"))
  )
  (setq k 0 ce (getvar "CMDECHO"))
  (setvar "CMDECHO" 0)
  (foreach nm lst
    (if (tblobjname "BLOCK" nm)
      (progn
        (command "_.-PURGE" "_B" nm "_N")
        (if (null (tblobjname "BLOCK" nm)) (setq k (1+ k)))
      )
    )
  )
  (setvar "CMDECHO" ce)
  k
)

;; ================================================================
;; 五、主流程
;; ================================================================
;; slots = 槽位数（nil/0 = 用模板的）   cabs = 柜号表
;; per   = 每框台数（nil = 按框宽自动）  bx by = 第 1 框左下角
;; write = T 真铺 / nil 只算不铺
(defun pgt:go (slots cabs per bx by write / ok msg dfs cabn hdrn n
               fa ar fr cr hr pr fw fh step hw cw
               crx cry hrx hry phx phy
               m k nfr fi fi2 j idx left cno e tpl tot
               fok hok cok pok cpur
               ftop cabx caby hdrx hdry phxx phyy cabht)
  (cond
    ((null (pgt:ensure))
     "缺 属性块-槽位增减.lsp（找不到或加载失败），没动图。")
    ((null cabs)
     "柜号清单是空的，没动图。")
    (T
     ;; --- 模板文件齐不齐 ---
     (setq msg "")
     (foreach tpl (list "图框模版.dwg" "柜块模版.dwg" "表头块模版.dwg" "占位块.dwg")
       (if (null (pgt:tpl tpl)) (setq msg (strcat msg "  缺模板：" tpl SEP)))
     )
     (cond
       ((/= msg "")
        (strcat "模板不齐，没动图：" SEP msg
                "  模板目录：" (if (pgt:tpldir) (pgt:tpldir) "?")))
       ((and write (null (pgt:ms)))
        "拿不到模型空间（COM 没通），没动图。")
       (T
        ;; --- 把四个块定义带进本图（只加定义，不加图元）---
        (pgt:import "图框模版.dwg" "图框模版")
        (pgt:import "柜块模版.dwg" "柜块模版")
        (pgt:import "表头块模版.dwg" "表头块模版")
        (pgt:import "占位块.dwg" "占位块")
        (cond
          ((or (null (pgt:defp "图框模版")) (null (pgt:defp "柜块模版"))
               (null (pgt:defp "表头块模版")) (null (pgt:defp "占位块")))
           "四个块定义没全进到本图（模板插不进来？），没动图。")
          (T
           (setq cpur (pgt:purgeold))
           ;; --- 定槽 ---
           (setq dfs (pgt:defs slots "柜块模版" "表头块模版"))
           (setq cabn (car dfs) hdrn (cadr dfs) n (caddr dfs))
           ;; --- 量几何 ---
           (setq fa (pgt:fanchor))
           (setq ar (if fa (pgt:rng (car fa))))
           (setq cr (pgt:rng cabn)
                 hr (pgt:rng hdrn)
                 pr (pgt:rng "占位块"))
           (cond
             ((null fa)
              "图框模版里找不到锚块（那个 * 开头的匿名块参照），没动图。")
             ((or (null ar) (null cr) (null hr) (null pr))
              "量不到块定义几何（图框 / 柜块 / 表头 / 占位块 有一个缺），没动图。")
             (T
              (setq fw (- (nth 2 ar) (car ar)))        ; 框宽 420
              (setq fh (- (nth 3 ar) (nth 1 ar)))      ; 框高 297
              (setq step (+ fw *pgt:cgap*))            ; 框间距 470
              (setq hw (- (nth 2 hr) (car hr)))        ; 表头块宽 40
              (setq cw (- (nth 2 cr) (car cr)))        ; 柜块宽 35
              (setq crx (car cr) cry (nth 3 cr))       ; 柜块几何 左 / 顶
              (setq hrx (car hr) hry (nth 3 hr))       ; 表头几何 左 / 顶
              (setq phx (car pr) phy (nth 3 pr))       ; 占位块几何 左 / 顶
              (setq cabht (- cry (nth 1 cr)))          ; 柜块几何高
              ;; 每框几台：框内净宽 / 柜宽
              (setq k (if (and per (> per 0)) per
                        (fix (/ (- fw (+ *pgt:padl* hw)) (float cw)))))
              (if (< k 1) (setq k 1))
              (setq m (length cabs))
              (setq nfr (pgt:ceil m k))
              ;; 与第几台无关的那几个 y / 偏移，循环外算一次
              (setq ftop (+ by fh))                          ; 框顶
              (setq caby (- ftop *pgt:padt* cry))            ; 柜块插入点 y
              (setq hdry (- ftop *pgt:padt* hry))            ; 表头插入点 y
              (setq phyy (- ftop *pgt:padt* *pgt:phgap* phy)) ; 占位块插入点 y
              ;; --- 逐框铺 ---
              (setq tot 0 fi 0 fok 0 hok 0 cok 0 pok 0)
              (while (< fi nfr)
                (setq left (+ bx (* fi step)))               ; 本框左下角 x
                (if write
                  (progn
                    ;; 图框：COM 插 + COM 炸开（框左下角在定义内要反向补偿）
                    (setq e (pgt:ins "图框模版"
                                     (list (- left (cadr fa) (car ar))
                                           (- by (caddr fa) (nth 1 ar)))))
                    (if e (progn (setq fok (1+ fok)) (pgt:exp e)))
                    ;; 本框表头，只一枚
                    (if (pgt:ins hdrn (list (- (+ left *pgt:padl*) hrx) hdry))
                      (setq hok (1+ hok))
                    )
                  )
                )
                ;; 本框的柜 + 占位块
                (setq j 0)
                (while (and (< j k) (< (+ (* fi k) j) m))
                  (setq idx (+ (* fi k) j))
                  (setq cno (nth idx cabs))
                  (setq cabx (+ left *pgt:padl* hw (* j cw)))   ; 本台柜几何左
                  (if write
                    (progn
                      (setq e (pgt:ins cabn (list (- cabx crx) caby)))
                      (if e (progn (setq cok (1+ cok)) (pgt:setatt e "柜号" cno)))
                      (if (pgt:ins "占位块" (list (- cabx phx) phyy))
                        (setq pok (1+ pok))
                      )
                    )
                  )
                  (setq tot (1+ tot))
                  (setq j (1+ j))
                )
                (setq fi (1+ fi))
              )
              ;; --- 报告 ---
              (strcat
                (if write "已铺" "【只算没铺】")
                "：槽位 " (itoa n)
                "（" (if (= cabn "柜块模版") "用模板定义" "现场克隆了新定义") "，柜块几何高 "
                (rtos cabht 2 0) "）" SEP
                "  柜 " (itoa m) " 台 / 每框 " (itoa k) " 台 / 共 " (itoa nfr) " 框" SEP
                (if write
                  (strcat "  实插：图框 " (itoa fok) "/" (itoa nfr)
                          "，表头 " (itoa hok) "/" (itoa nfr)
                          "，柜块 " (itoa cok) "/" (itoa tot)
                          "，占位块 " (itoa pok) "/" (itoa tot) SEP)
                  (strcat "  只算没铺：一个字没写。" SEP))
                "  清未引用克隆 " (itoa (if cpur cpur 0)) " 个" SEP
                "  框 " (rtos fw 2 0) "x" (rtos fh 2 0)
                "，间距 " (rtos step 2 0)
                "；柜块插入点 y = " (rtos caby 2 1)
                "，第 1 台柜几何左 = " (rtos (+ bx *pgt:padl* hw) 2 1) SEP
                (if write "  没存盘，改动都在内存里。" "")
              )
             )
           )
          )
        )
       )
     )
    )
  )
)

;; ================================================================
;; 六、入口
;; ================================================================

;; 柜号可以给字符串（"AH01,AH02"）也可以直接给表（("AH01" "AH02")）
(defun pgt:cl (c)
  (if (listp c) c (pgt:split c))
)

;; 每框台数要走指定值时，直接调 (pgt:go 槽数 柜号表 每框台数 bx by write)
(defun pgt:run (slots cabs)
  (pgt:go slots (pgt:cl cabs) nil 0.0 0.0 T)
)

(defun pgt:dry (slots cabs)
  (pgt:go slots (pgt:cl cabs) nil 0.0 0.0 nil)
)

(defun c:PGT ( / s per cabs r)
  (setq s (getint "\n槽位数 <用模板自带的>: "))
  (setq per (getint "\n每框台数 <按框宽自动>: "))
  (setq cabs (getstring T "\n柜号清单（逗号或空格分隔，如 AH01,AH02）: "))
  (setq r (pgt:go s (pgt:split cabs) per 0.0 0.0 T))
  (princ (strcat SEP r))
  (princ)
)

(princ "\n属性块-铺图.lsp 已加载。命令 PGT（或 (pgt:run 9 \"AH01,AH02\")）。")
(princ)


;;; ================================================================
;;; 模块 五、属性块-批量填数.lsp（PLT，命令 PLT）
;;; ================================================================

;;; ============================================================
;;; 属性块-批量填数.lsp                                命令：PLT
;;; ------------------------------------------------------------
;;; 作用
;;;   在 PGT 铺好的空壳上，按一份清单把数据灌进去 —— 只写字，
;;;   不动任何几何、不建块、不插块、不扩容。
;;;     · 柜块：柜用途 / 柜型 / 柜尺寸 / 容量功率 / 分支电流 / 备注
;;;     · 柜块槽位：元件NN规格 / 元件NN数量
;;;     · 表头块：主母线规格 / 电压等级
;;;     · 表头块槽位：元件NN名称 / 元件NN型号
;;;     · 图签 7 格：柜型 / 图名 / 数量 / 工程号 / 图号 / 共X张 / 第X张
;;;       （模型空间的独立 TEXT，不是块属性）
;;;   没数据的槽一律写空 —— 重复跑幂等，不会留残留旧值。
;;;
;;; 清单格式（与 acad-mcp 的 compact 口同源）
;;;     表头 | 3*80*6 | 10kV                        <- 可选，可写多遍：
;;;                                                   第 j 遍对应图上从左到右
;;;                                                   第 j 枚表头（箱变两段）
;;;     图签 | GGD | 进线 D1 | JX01 | QC | *         <- 可选
;;;     @AH01 | 进线柜 | KYN28A-12 | 800*1500*2300 | 630KVA | | 下进上出
;;;     1 | 真空断路器 | VS1-12 | 630A 25kA | 1
;;;     5 | 电压互感器 | JDZ10-10 | 10/0.1kV | 3
;;;     @AH02 | ...
;;;   规则：
;;;     · 柜头行必须 @ 开头：柜号 | 柜用途 | 柜型 | 柜尺寸 | 容量功率 |
;;;       分支电流 | 备注（后 6 段可省，空段有意义）
;;;     · 元件行：槽号 | 名称 | 型号 | 规格 | 数量；槽号可写 - 或整段省略
;;;     · 字段分隔用 | 或 tab（**连续空格不拆**，规格里本来就有空格）
;;;     · 图签行：柜型 | 图名 | 图号 | 工程号前缀 | 日期（后 2 段可省）
;;;         - 工程号：日期段空 -> 前缀原样；`*` -> 前缀 + 当天 YYYYMMDD；
;;;           给了别的就照拼
;;;         - 数量 / 共X张 / 第X张 三格自动算，不用写
;;;         - 整行不写 -> 那 4 格**写空**（清掉图框模版预置值；
;;;           与 acad-mcp 的 frame_finish 同口径，2026-09-20 改）
;;;     · 空行 / # / // 开头的行跳过
;;;
;;; 入口
;;;   (plt:run "清单文本")           真写（含图签）
;;;   (plt:dry "清单文本")           只算不写（报槽数 + 逐槽分配 + 警告）
;;;   (plt:need "清单文本")          只报需要几个槽
;;;   (plt:runfile "清单.txt") / (plt:dryfile ...)   从 GBK 文件读
;;;   (plt:titlerun "柜型|图名|图号|工程号前缀|日期")  只重填图签
;;;      只填图签的专用入口见 → 属性块-填图签.lsp（命令 TQ，带逐格明细）
;;;   命令 PLT —— 交互，问清单文件路径
;;;
;;; 为什么不能拿 JYJ 循环喂
;;;   JYJ 的槽位是「占表头第一个空槽」→ 槽号依赖喂入顺序；本工具是
;;;   「显式槽号优先，没给的按首次出现顺序取最小空槽」→ 与 MCP 的
;;;   att_panel(compact=) 同口径：同名同型号在所有柜落**同一槽**。
;;;
;;; 已知边界
;;;   1 不扩容：清单需要的槽数 > 图上槽数 → 直接拒绝并报数字，
;;;     请先用 PGT / XBT 按需要的槽数铺图。
;;;   2 【2026-09-20 起】行高、多表头都已支持：
;;;     · 多行规格：槽位若已被 XBT 加过行高（标签是 元件NN规格1..M），
;;;       本工具按同一套宽度规则拆行分别落位；单行标签（元件NN规格）
;;;       照旧只写一行、超宽仍只报 warning。
;;;     · 多表头：清单里「表头」行可以写多遍，第 j 遍对应图上从左到右
;;;       第 j 枚表头（箱变两段：第 1 遍高压、第 2 遍低压）。只写一遍时
;;;       发给所有表头（旧行为，KYN28 单段不受影响）。
;;;     · 表头参照按插入点 x 从左到右排序后逐枚对应（不再按图元生成序）。
;;;     · 本柜某槽只填了 kk 行（< 该槽格数 m）时，这 kk 行【整组】挪到槽的
;;;       垂直中心（锚点 = 该槽「数量」属性的 y；位移按相对给，见 plt:midrow）。
;;;
;;; 依赖
;;;   无（自包含）。只认「图上已经铺好的块」。
;;;
;;; 写值走 entmod 改组码 1，不走 COM —— CWJH 已验证这条路稳；
;;; 本机 vlax-invoke 调 COM 方法不通（要走 vla- 直连），能不碰就不碰。
;;;
;;; 注意：substr / strlen 在 DBCS 下按**字节**计数（中文占 2 字节），
;;;   所以下面凡是切中文前缀一律用字节下标，且按 ASCII 单字节分隔符
;;;   逐字节拆 —— 不能拿 vl-string-search 的下标去 substr（单位不同）。
;;;
;;; 编码：ANSI/GBK 无 BOM
;;; ============================================================
(vl-load-com)
(if (not (boundp 'SEP)) (setq SEP (chr 10)))

;; ------------------------------------------------------------
;; 常量
;; ------------------------------------------------------------
(setq *plt:prefix*   "元件")        ; 槽位标签前缀
(setq *plt:tag-cab*  "柜号")        ; 认柜块参照的标签
(setq *plt:tag-hdr*  "主母线规格")  ; 认表头块参照的标签
 (setq *plt:slot-col* 9.0)           ; 规格栏可容宽度（em）= 27 列宽 / 3.0 字高
(setq *plt:em-ascii* 0.5)           ; 西文平均字宽（em）
;; 图签（模型空间独立 TEXT）—— 实测口径见「四·五」节
(setq *plt:frame-w* 420.0)          ; 单套图框宽（A3 横 420）
(setq *plt:tb-cells* '(
  ("product" -100.0 -50.0 18.5 28.0)
  ("title"   -100.0 -50.0  9.0 18.5)
  ("qty"      -50.0   0.0 18.5 28.0)
  ("project"  -50.0   0.0  9.0 18.5)
  ("code"     -50.0   0.0  0.0  9.0)
  ("total"   -100.0 -75.0  0.0  9.0)
  ("no"       -75.0 -50.0  0.0  9.0)))

;; ================================================================
;; 一、小工具（全部按字节走，DBCS 安全）
;; ================================================================

;; 去首尾半角空白（空格 / tab / 回车）—— 只切 ASCII，不会切坏中文
(defun plt:trim (s / n)
  (setq s (if s s ""))
  (while (and (> (strlen s) 0) (member (ascii (substr s 1 1)) '(32 9 13)))
    (setq s (substr s 2))
  )
  (setq n (strlen s))
  (while (and (> n 0) (member (ascii (substr s n 1)) '(32 9 13)))
    (setq s (substr s 1 (1- n)) n (1- n))
  )
  s
)

;; 按单字节分隔符拆（逐字节走；中文被切成单字节再拼回去，字节序列不变）
(defun plt:bcut (s d / res cur i n ch)
  (setq res nil cur "" i 1 n (strlen s))
  (while (<= i n)
    (setq ch (substr s i 1))
    (if (= d (ascii ch))
      (setq res (cons cur res) cur "")
      (setq cur (strcat cur ch))
    )
    (setq i (1+ i))
  )
  (reverse (cons cur res))
)

;; s 是否以 p 开头（LISP 字符串比较就是字节序列比较）
(defun plt:pfx (s p / n)
  (setq n (strlen p))
  (and (>= (strlen s) n) (= p (substr s 1 n)))
)

;; 纯 ASCII 数字串
(defun plt:num (s / i n c ok)
  (setq s (if s s ""))
  (setq i 1 n (strlen s) ok (if (> n 0) T nil))
  (while (<= i n)
    (setq c (ascii (substr s i 1)))
    (if (or (< c 48) (> c 57)) (setq ok nil))
    (setq i (1+ i))
  )
  ok
)

;; 全角竖线 -> 半角（可能多个，循环替换）
(defun plt:normbar (s / k)
  (setq k 0)
  (while (and (< k 20) (vl-string-search "｜" s))
    (setq s (vl-string-subst "|" "｜" s) k (1+ k))
  )
  s
)

;; 去首部分隔符与空白（含全角 ｜ ：——GBK 双字节标点首字节 163，跳 2 字节）
(defun plt:lstrip (s / go c)
  (setq go T)
  (while (and go (> (strlen s) 0))
    (setq c (ascii (substr s 1 1)))
    (cond
      ((member c '(32 9 13 124 58)) (setq s (substr s 2)))
      ((= c 163) (setq s (substr s 3)))
      (T (setq go nil))
    )
  )
  s
)

;; 一行 -> 字段表：tab 优先（连续 tab 剔空段），其次 | ，都没有则整行一段
(defun plt:fields (ln / s out)
  (setq s (plt:normbar (if ln ln "")))
  (cond
    ((vl-string-search "\t" s)
     (setq out (vl-remove "" (plt:bcut s 9)))
    )
    ((vl-string-search "|" s)
     (setq out (plt:bcut s 124))
    )
    (T (setq out (list s)))
  )
  (mapcar 'plt:trim out)
)

;; 文本 -> 行表（按 LF 拆；CR 由 trim 收掉）
(defun plt:lines (tx)
  (mapcar 'plt:trim (plt:bcut (if tx tx "") 10))
)

;; 读 GBK 文本文件 -> 字符串（每行补 LF）；打不开返回 nil
(defun plt:readfile (f / h ln out)
  (setq h (open f "r"))
  (if (null h)
    nil
    (progn
      (setq out "")
      (while (setq ln (read-line h))
        (setq out (strcat out ln "\n"))
      )
      (close h)
      out
    )
  )
)

;; s 以标签 p 开头、且 p 之后紧跟分隔符或行尾 -> T
;;   （「电压互感器」也以「电压」开头 —— 不加这一条会被吃成信息区）
(defun plt:hit (s p / n r c)
  (setq n (strlen p))
  (if (and (>= (strlen s) n) (= p (substr s 1 n)))
    (progn
      (setq r (substr s (1+ n)))
      (if (= r "")
        T
        (progn
          (setq c (ascii (substr r 1 1)))
          (if (member c '(32 9 124 58 163)) T nil)
        )
      )
    )
    nil
  )
)

;; 补/截到 n 个元素（不足补 ""）
(defun plt:pad (lst n / out i)
  (setq out nil i 0)
  (while (and lst (< i n))
    (setq out (cons (car lst) out) lst (cdr lst) i (1+ i))
  )
  (setq out (reverse out))
  (while (< i n)
    (setq out (append out (list "")) i (1+ i))
  )
  out
)

;; nil -> ""
(defun plt:s1 (x)
  (if x x "")
)

;; 连续整数表 (a a+1 ... b)
(defun plt:seq (a b / out)
  (setq out nil)
  (while (>= b a)
    (setq out (cons b out) b (1- b))
  )
  out
)

;; 槽号 k -> 槽位标签（1..9 补零成 01..09）
(defun plt:tagk (k suf)
  (strcat *plt:prefix* (if (< k 10) (strcat "0" (itoa k)) (itoa k)) suf)
)

;; 估算字符串显示宽度（em）：ASCII 0.5、中文（GBK 双字节）1.0
(defun plt:em (s / i n w c)
  (setq s (if s s ""))
  (setq i 1 n (strlen s) w 0.0)
  (while (<= i n)
    (setq c (ascii (substr s i 1)))
    (if (< c 128)
      (setq w (+ w *plt:em-ascii*) i (1+ i))
      (setq w (+ w 1.0) i (+ i 2))
    )
  )
  w
)

;; ================================================================
;; 二、解清单
;; ================================================================

;; 注释行正文：剥掉行首的 # / // 前缀与空白（槽位顺序块用）
(defun plt:cmt (ln / s)
  (setq s (plt:trim ln))
  (while (or (plt:pfx s "#") (plt:pfx s "//"))
    (setq s (plt:trim (substr s 2)))
  )
  s
)

;; 清单末尾「# 槽位顺序（…）」注释块 -> ((段号 (槽号 . 名称) …) …)
;;   · 块头：注释行正文以「槽位顺序」开头 —— 一个块 = 一段，段号按块
;;     出现顺序从 1 起，与「表头行切段」切出来的段号一一对应
;;     （网页生成器写回时先高压后低压，与图上表头从左到右同序）
;;   · 块体：注释行正文形如「序号|名称」（| / tab 分隔都认）
;;   · 槽号【按块内行序重编 1,2,3…】，不信行首那个序号 ——
;;     生成器的序号在箱变低压段是接着高压段续号的（4、5…），
;;     而本程序两段各自从第 1 槽起，按行序重编才与段号口径对齐
(defun plt:sdefs (tx / out cur on ln b fs n)
  (setq out nil cur nil on nil)
  (foreach ln (plt:lines tx)
    (if (member (substr (plt:trim ln) 1 1) '("#" "/"))
      (progn
        (setq b (plt:cmt ln))
        (cond
          ((plt:pfx b "槽位顺序")
           (if on (setq out (cons (reverse cur) out)))
           (setq cur nil on T)
          )
          (on
           (setq fs (plt:fields b))
           (if (and (cadr fs) (/= (cadr fs) ""))
             (setq cur (cons (cons (1+ (length cur)) (cadr fs)) cur))
           )
          )
        )
      )
      (if on (progn (setq out (cons (reverse cur) out)) (setq cur nil on nil)))
    )
  )
  (if on (setq out (cons (reverse cur) out)))
  (setq out (reverse out) n 0)
  (mapcar '(lambda (x) (setq n (1+ n)) (cons n x)) out)
)

;; 取第 sg 段的槽位顺序定义（没这一块 -> nil = 退回首次出现顺序）
(defun plt:sdef-at (sdefs sg / r x)
  (setq r nil)
  (foreach x sdefs
    (if (and (null r) (= (car x) sg)) (setq r (cdr x)))
  )
  r
)

;; 清单文本 -> (母线 电压 柜表 警告表 图签 表头段 槽位顺序段)
;;   柜表 = ((柜号 柜用途 柜型 柜尺寸 容量功率 分支电流 备注 元件表) ...)
;;   元件表 = ((槽号 名称 型号 规格 数量 行号) ...)   槽号 nil = 没给
;;   槽位顺序段 = ((段号 (槽号 . 名称) …) …)   清单没写这块就是 nil
(defun plt:parse (tx / bus vol cabs cur comps warns n s fs e slot tb hdrs hb hv
                     seg cseg sd)
  (setq bus "" vol "" cabs nil cur nil comps nil warns nil n 0 tb nil hdrs nil
        seg 0 cseg 1)
  (foreach s (plt:lines tx)
    (setq n (1+ n))
    (cond
      ;; 空行 / 注释
      ;;   （# 行整行跳过；末尾那段「# 槽位顺序」块由 plt:sdefs 单独
      ;;     解析成排槽定义，不在这里当数据行处理）
      ((= s "") nil)
      ((plt:pfx s "#") nil)
      ((plt:pfx s "//") nil)
      ;; 图签行（必须在柜头行/元件行之前判 —— 它不以 @ 开头）
      ((plt:hit s "图签")
       (setq fs (plt:fields (plt:lstrip (substr s 5))))
       (setq tb (plt:pad fs 5))
      )
      ;; 信息区（表头 / 母线 / 母排 / 电压等级 / 电压）
      ;;   表头行可写多遍：第 j 遍对应图上【从左到右第 j 枚】表头 ——
      ;;   箱变两段就是「第 1 遍高压、第 2 遍低压」。只写一遍时发给所有表头
      ;;   （旧行为，KYN28 单段不受影响）。
      ((plt:hit s "表头")
       (setq fs (plt:fields (plt:lstrip (substr s 5))))
       (setq hb (if (and fs (car fs) (/= (car fs) "")) (car fs) ""))
       (setq hv (if (and fs (cadr fs)) (cadr fs) ""))
       (setq hdrs (cons (list hb hv) hdrs))
       (if (= (length hdrs) 1) (setq bus hb vol hv))
       ;; 【段号自增】一条表头行 = 开始新的一段 —— 其后出现的柜都属这一段
       ;;   只写 1 条表头行 -> 全图 1 段（KYN28 老路，行为不变）
       (setq seg (1+ seg))
      )
      ((plt:hit s "母线") (setq bus (plt:lstrip (substr s 5))))
      ((plt:hit s "母排") (setq bus (plt:lstrip (substr s 5))))
      ((plt:hit s "电压等级") (setq vol (plt:lstrip (substr s 9))))
      ((plt:hit s "电压") (setq vol (plt:lstrip (substr s 5))))
      ;; 柜头行
      ((plt:pfx s "@")
       (if cur (setq cabs (cons (append cur (list (reverse comps)) (list cseg)) cabs)))
       (setq cur nil comps nil)
       (setq fs (plt:fields (substr s 2)))
       (if (or (null fs) (null (car fs)) (= (car fs) ""))
         (setq warns (cons (strcat "第 " (itoa n) " 行柜头行没写柜号 —— 跳过") warns))
         (progn
           (setq cur (cons (car fs) (plt:pad (cdr fs) 6)))
           ;; 段号【当场快照】—— 不能等收尾再读 seg，
           ;;   段号会在柜头行之间（下一条表头行处）变
           (setq cseg (if (< seg 1) 1 seg))
         )
       )
      )
      ;; 元件行
      (T
       (if (null cur)
         (setq warns (cons (strcat "第 " (itoa n) " 行前面还没有柜头行 —— 跳过"
                                   "（柜头行必须以 @ 开头）") warns))
         (progn
           (setq fs (plt:fields s) slot nil)
           (if (and fs (plt:num (car fs)))
             (setq slot (atoi (car fs)) fs (cdr fs))
             (if (member (car fs) '("-" "_" "—"))
               (setq fs (cdr fs))
             )
           )
           (if (or (null fs) (null (car fs)) (= (car fs) ""))
             (setq warns (cons (strcat "第 " (itoa n) " 行元件行没写名称 —— 跳过") warns))
             (progn
               (setq e (list slot
                             (car fs)
                             (plt:s1 (cadr fs))
                             (plt:s1 (caddr fs))
                             (plt:s1 (cadddr fs))
                             n))
               (setq comps (cons e comps))
             )
           )
         )
       )
      )
    )
  )
  (if cur (setq cabs (cons (append cur (list (reverse comps)) (list cseg)) cabs)))
  (setq sd (plt:sdefs tx))
  (list bus vol (reverse cabs) (reverse warns) tb (reverse hdrs) sd)
)

;; ================================================================
;; 三、排槽
;; ================================================================

;; 最小未被占用的槽号（从 1 起找）
(defun plt:freeslot (used / k)
  (setq k 1)
  (while (member k used) (setq k (1+ k)))
  k
)

;; 柜表 -> ((键 . 槽号) ...) 与需要的槽数
;;   键 = 名称 + tab + 型号（同名不同型号各自占槽，与 MCP 口径一致）
;;   def = 本段的槽位顺序定义 ((槽号 . 名称) ...) —— 清单末尾网页生成器
;;         写回的「# 槽位顺序」块（plt:sdefs 解析）；nil = 没写这块，退回老规则
;;   ① 显式槽号先登记（同名冲突取小的）
;;   ② 没给槽号的：先查 def —— 名称命中且那个槽还空着就落这位；
;;      定义里没有的，按首次出现顺序取最小空槽
(defun plt:plan1 (cabs def / map used key k e slot need d sd)
  (setq map nil used nil)
  (setq d (mapcar '(lambda (p) (cons (cdr p) (car p))) def))
  (foreach cab cabs
    (foreach e (nth 7 cab)
      (setq slot (car e))
      (if slot
        (progn
          (setq key (strcat (cadr e) "\t" (caddr e)))
          (setq k (assoc key map))
          (if k
            (if (< slot (cdr k)) (setq map (subst (cons key slot) k map)))
            (setq map (cons (cons key slot) map))
          )
          (if (not (member slot used)) (setq used (cons slot used)))
        )
      )
    )
  )
  (foreach cab cabs
    (foreach e (nth 7 cab)
      (if (null (car e))
        (progn
          (setq key (strcat (cadr e) "\t" (caddr e)))
          (if (null (assoc key map))
            (progn
              (setq sd (cdr (assoc (cadr e) d)))
              (if (and sd (not (member sd used)))
                (setq slot sd)
                (setq slot (plt:freeslot used))
              )
              (setq map (cons (cons key slot) map))
              (setq used (cons slot used))
            )
          )
        )
      )
    )
  )
  (setq need 0)
  (foreach kv map
    (if (> (cdr kv) need) (setq need (cdr kv)))
  )
  (list map need)
)

;; 单段排槽（KYN28 / 只写一条表头行时走这里）
;;   def = 第 1 段的槽位顺序定义（清单末尾「# 槽位顺序」块，nil = 没写）
(defun plt:plan (cabs def) (plt:plan1 cabs def))

;; ================================================================
;; 三·二、分段排槽（箱变两段独立表）
;; ================================================================
;; 【表头行切段】清单里每写一条表头行 = 开始新的一段：
;;   表头 | TMY-50*5 | 10kV           <- 段 1（= 图上最左那枚表头）
;;   @G1 … @BYQ …                    <- 属段 1
;;   表头 | TMY-100*8 N80*8 | 0.4kV  <- 段 2（= 图上最右那枚表头）
;;   @D1 … @D2 …                     <- 属段 2
;; 只写 1 条表头行 -> 1 段 -> 走 plt:plan 老路（KYN28 不受影响）。
;;
;; 【口径】
;;   · 两段【各自从第 1 槽起】编号 —— 同一个槽号在两段是不同元件
;;   · 段内排槽规则与 plt:plan 完全一致（同名同型号共槽、取最小空槽）
;;   · 槽数 = max(各段槽数) —— 块定义共用，只能按最宽那段定
;;   · 表头槽位表【各写各段】：第 j 枚表头只写第 j 段的元件
;;
;; pls = ((段号 map need) …)，段号升序
(defun plt:cseg (cab / sg)
  (setq sg (nth 8 cab))
  (if (and sg (numberp sg) (>= sg 1)) sg 1)
)

(defun plt:segs (cabs / o z sg)
  (setq o nil)
  (foreach z cabs
    (setq sg (plt:cseg z))
    (if (not (member sg o)) (setq o (cons sg o)))
  )
  (reverse o)
)

(defun plt:segc (cabs sg / o z)
  (setq o nil)
  (foreach z cabs
    (if (= (plt:cseg z) sg) (setq o (cons z o)))
  )
  (reverse o)
)

(defun plt:planseg (cabs sdefs / o sg)
  (setq o nil)
  (foreach sg (plt:segs cabs)
    (setq o (cons (cons sg (plt:plan1 (plt:segc cabs sg)
                                      (plt:sdef-at sdefs sg))) o))
  )
  (reverse o)
)

(defun plt:needseg (pls / m x)
  (setq m 0)
  (foreach x pls
    (if (> (caddr x) m) (setq m (caddr x)))
  )
  m
)

(defun plt:maps (pls sg / r x)
  (setq r nil)
  (foreach x pls
    (if (and (null r) (= (car x) sg)) (setq r (cadr x)))
  )
  r
)

;; 槽号 -> 键（反查）
(defun plt:keyat (map k / r)
  (setq r nil)
  (foreach kv map
    (if (and (= (cdr kv) k) (null r)) (setq r (car kv)))
  )
  r
)

;; 本柜 槽号 -> 元件 映射
(defun plt:cabmap1 (cab map / out e key slot)
  (setq out nil)
  (foreach e (nth 7 cab)
    (setq key (strcat (cadr e) "\t" (caddr e)))
    (setq slot (cdr (assoc key map)))
    (if slot (setq out (cons (cons slot e) out)))
  )
  out
)

;; 单段口径（老调用点继续用）
(defun plt:cabmap (cab map) (plt:cabmap1 cab map))

;; 本柜 槽号 -> 元件（单段 / 分段通用）
;;   pls 非 nil（清单写了多条表头行）-> 按本柜段号取那一段的键表
(defun plt:cabget (cab map pls)
  (plt:cabmap1 cab (if pls (plt:maps pls (plt:cseg cab)) map))
)

;; ================================================================
;; 四、图上扫描 / 读写属性
;; ================================================================

;; 块参照的属性表 ((标签 . 属性图元名) ...)
(defun plt:atts (ref / e ed out)
  (setq e (entnext ref) out nil)
  (while (and e (setq ed (entget e)) (= "ATTRIB" (cdr (assoc 0 ed))))
    (setq out (cons (cons (cdr (assoc 2 ed)) e) out))
    (setq e (entnext e))
  )
  (reverse out)
)

;; 属性图元名 -> 文本值（组码 1）
(defun plt:atext (e / ed)
  (setq ed (entget e))
  (plt:s1 (cdr (assoc 1 ed)))
)

;; 属性表里取某标签的**文本值**（没有该标签返回 nil）
;;   注意：plt:atts 给的是「标签 -> 属性图元名」，值还要再取一步组码 1
(defun plt:val (atts tg / p)
  (setq p (assoc tg atts))
  (if p (plt:atext (cdr p)) nil)
)

;; 属性表里 元件NN 的最大槽号（没有则 0）
(defun plt:slotmax (atts / mx tg nn)
  (setq mx 0)
  (foreach a atts
    (setq tg (car a))
    (if (plt:pfx tg *plt:prefix*)
      (progn
        (setq nn (substr tg 5 2))     ; 「元件」= 4 字节，槽号 2 字节
        (if (plt:num nn)
          (if (> (atoi nn) mx) (setq mx (atoi nn)))
        )
      )
    )
  )
  mx
)

;; ---- 表头排序 / 按宽度拆行 / 多行规格落位（2026-09-20 加，为箱变两段）----

;; 表头参照按插入点 x 从小到大排（左 -> 右）
;;   箱变两段靠这个顺序把「第 1 遍表头行」发给最左那枚
(defun plt:hsort (lst / out mn)
  (setq out nil)
  (while lst
    (setq mn (car lst))
    (foreach p lst (if (< (car p) (car mn)) (setq mn p)))
    (setq out (cons (cdr mn) out))
    (setq lst (vl-remove mn lst))
  )
  (reverse out)
)

;; cur 里最后一个可断点的字节下标（空格 / , ; 单字节；、= A1A2 取第 2 字节）
;;   没有可断点返回 nil -> 调用方硬切
(defun plt:lbk (s / i n c r)
  (setq i 1 n (strlen s) r nil)
  (while (< i n)
    (setq c (ascii (substr s i 1)))
    (cond
      ((or (= c 32) (= c 47) (= c 44) (= c 59)) (setq r i) (setq i (1+ i)))
      ((and (= c 161) (= (ascii (substr s (1+ i) 1)) 162))
       (setq r (+ i 1)) (setq i (+ i 2)))
      ((>= c 128) (setq i (+ i 2)))
      (T (setq i (1+ i)))
    )
  )
  r
)

;; 按显示宽度拆行 -> (行1 行2 ...)；断点优先 空格/标点，无断点则硬切
;;   宽度口径与 XBT 算行高完全一致（同一套 *plt:em-ascii* / *plt:slot-col*）
(defun plt:wrap (s w / out cur cw i n c ew step ch lb)
  (setq s (if s s "") out nil cur "" cw 0.0 i 1 n (strlen s))
  (while (<= i n)
    (setq c (ascii (substr s i 1)))
    (if (< c 128) (setq ew *plt:em-ascii* step 1) (setq ew 1.0 step 2))
    (if (and (> (+ cw ew) w) (> (strlen cur) 0))
      (progn
        (setq lb (plt:lbk cur))
        (if lb
          (progn
            (setq out (cons (plt:trim (substr cur 1 (1- lb))) out))
            (setq cur (plt:trim (substr cur (1+ lb))))
            (setq cw (plt:em cur))
          )
          (progn
            (setq out (cons (plt:trim cur) out))
            (setq cur "" cw 0.0)
          )
        )
      )
      (progn
        (setq ch (substr s i step))
        (setq cur (strcat cur ch) cw (+ cw ew) i (+ i step))
      )
    )
  )
  (if (> (strlen cur) 0) (setq out (cons (plt:trim cur) out)))
  (if (null out) (setq out (list "")))
  (reverse out)
)

;; 标签 tg 是不是「槽 k 的规格第 n 行」-> n；元件NN规格（旧单行形态）返回 0
(defun plt:specno (tg k / pre n rest)
  (setq pre (plt:tagk k "规格") n 0)
  (if (and (> (strlen tg) (strlen pre)) (= pre (substr tg 1 (strlen pre))))
    (progn
      (setq rest (substr tg (1+ (strlen pre))))
      (if (and (= (strlen rest) 1) (plt:num rest) (>= (atoi rest) 1))
        (setq n (atoi rest))
      )
    )
  )
  n
)

;; 写一个槽的「规格」-> (写的格数 行数)；行数 0 = 单行标签
;;   多行标签（元件NN规格1..M，XBT 加过行高留下的）按宽度拆成 M 行分别落位；
;;   值不够 M 行的，多余格子写空 —— 幂等，不留残留
(defun plt:putspec (atts k val write / m i n rows hit)
  (setq m 0)
  (foreach a atts
    (setq n (plt:specno (car a) k))
    (if (> n m) (setq m n))
  )
  (if (> m 0)
    (progn
      (setq rows (plt:wrap val *plt:slot-col*) hit 0)
      (foreach i (plt:seq 1 m)
        (if (plt:put atts (plt:tagk k (strcat "规格" (itoa i)))
                     (if (nth (1- i) rows) (nth (1- i) rows) "") write)
          (setq hit (1+ hit))
        )
      )
      ;; (写的格数 格数 实际行数) —— 格数是两段取 max 定的，
      ;;   本柜可能只填了前几行 -> 主流程拿实际行数去居中
      (list hit m (length rows))
    )
    (list (if (plt:put atts (plt:tagk k "规格") val write) 1 0) 0 0)
  )
)

;; 块定义里槽 k 的规格 ATTDEF 各行 y（降序 = 第1行..第m行）
;;   只为取行距 P —— 块定义是标准位，参照被挪过也不影响
(defun plt:srow (bn k / b sub ed tg r n)
  (setq r nil)
  (setq b (tblobjname "BLOCK" bn))
  (setq sub (if b (cdr (assoc -2 (entget b))) nil))
  (while (and sub (/= "ENDBLK" (cdr (assoc 0 (setq ed (entget sub))))))
    (if (= "ATTDEF" (cdr (assoc 0 ed)))
      (progn
        (setq n (plt:specno (cdr (assoc 2 ed)) k))
        (if n (setq r (cons (cons n (caddr (assoc 10 ed))) r)))
      )
    )
    (setq sub (entnext sub))
  )
  (mapcar 'cdr (vl-sort r '(lambda (a b) (> (cdr a) (cdr b)))))
)

;; 实体的 10/11 点 y【一起下移 d】（两点同量，10/11 的相对关系不动）
;;   ★ 不能「直接把 10/11 都设成同一个 y」：属性是 72/74 非零的对正，
;;     实际落点由 11 点（对齐点）决定，10 点只是左基线，两者本来就差
;;     半个字高（实测 11.y = 10.y + 1.5）；都设成同一值会让文字整体
;;     偏 h/2（2026-09-20 实测：规格比数量低 1.5，改成相对位移后逐槽对中）。
;;   ★ 位移按「现值 - 目标值」算 -> 重复跑 d=0，天然幂等。
(defun plt:shdy (ed d / p q out)
  (setq out nil)
  (foreach p ed
    (if (and (member (car p) '(10 11)) (listp (cdr p)) (numberp (car (cdr p))))
      (progn
        (setq q (cdr p))
        (setq out (cons (cons (car p) (list (car q) (- (cadr q) d) (caddr q))) out))
      )
      (setq out (cons p out))
    )
  )
  (reverse out)
)

;; 槽 k 的规格格子有 m 行、本柜只填了 kk 行 -> 把这 kk 行【整组】挪到槽的垂直中心。
;;   锚点 = 该槽「数量」属性的 y（GGH 已把它摆成整槽居中，见 gh:shdn）
;;   行距 P 取块定义里该槽规格行的标准差，不依赖参照现状
;;   位移按【相对】给：把 10/11 一起下移「当前 y - 目标 y」，绝不把两点设成
;;   同一个值（对正不是基线时会把文字整体带偏 h/2 —— 见 plt:shdy）
;;   目标 = 锚点 + P*(kk-1)/2 - P*(n-1) 逐行算，用现值反推位移 -> 重复跑幂等
(defun plt:midrow (ref k m kk / e ed tg cn cy h P ys j n ty d)
  (if (and (> m 0) (> kk 0) (< kk m))
    (progn
      (setq cn (plt:tagk k "数量") cy nil h 3.0)
      (setq e (entnext ref))
      (while (and e (= "ATTRIB" (cdr (assoc 0 (setq ed (entget e))))))
        (setq tg (cdr (assoc 2 ed)))
        (if (= cn tg)
          (progn
            (setq cy (caddr (assoc 10 ed)))
            (setq h (cdr (assoc 40 ed)) h (if h h 3.0))
          )
        )
        (setq e (entnext e))
      )
      (if cy
        (progn
          (setq ys (plt:srow (cdr (assoc 2 (entget ref))) k))
          (setq P (if (and ys (cadr ys)) (- (car ys) (cadr ys)) 6.0))
          (setq e (entnext ref))
          (while (and e (= "ATTRIB" (cdr (assoc 0 (setq ed (entget e))))))
            (setq n (plt:specno (cdr (assoc 2 ed)) k))
            (if (and n (>= n 1) (<= n kk))
              (progn
                (setq ty (- (+ cy (* P (/ (1- kk) 2.0))) (* P (1- n))))
                (setq d (- (caddr (assoc 10 ed)) ty))
                (entmod (plt:shdy ed d))
              )
            )
            (setq e (entnext e))
          )
        )
      )
    )
  )
)

;; 模型空间扫描 -> (柜alist 表头图元表 图上最大槽号)
;;   柜alist = ((柜号 . 块参照图元名) ...)   表头 = (图元名 ...)
;;   靠**标签**认块，不靠块名（GKC 扩容后块名会被污染成 开关柜-AH01-AH01-…）
(defun plt:scan ( / ss i n e atts hd mx k cab hdr)
  (setq cab nil hdr nil mx 0)
  (setq ss (ssget "_X" '((0 . "INSERT") (410 . "Model"))))
  (if ss
    (progn
      (setq i 0 n (sslength ss))
      (while (< i n)
        (setq e (ssname ss i))
        (setq atts (plt:atts e))
        (setq hd (plt:val atts *plt:tag-cab*))
        (cond
          (hd (setq cab (cons (cons hd e) cab)))
          ;; 表头带上插入点 x —— 多表头（箱变两段）靠 x 定左右顺序
          ((assoc *plt:tag-hdr* atts)
           (setq hdr (cons (cons (car (cdr (assoc 10 (entget e)))) e) hdr)))
        )
        (setq k (plt:slotmax atts))
        (if (> k mx) (setq mx k))
        (setq i (1+ i))
      )
    )
  )
  (list (reverse cab) (plt:hsort hdr) mx)
)

;; 写一个标签的值；标签不存在返回 nil。
;;   write = nil 时只探测不落笔（dry 用），返回值仍表示「这一格存在」
(defun plt:put (atts tg val write / p e ed)
  (setq p (assoc tg atts))
  (if (null p)
    nil
    (progn
      (if write
        (progn
          (setq e (cdr p) ed (entget e))
          (if (assoc 1 ed)
            (entmod (subst (cons 1 val) (assoc 1 ed) ed))
            (entmod (append ed (list (cons 1 val))))
          )
          (entupd e)
        )
      )
      T
    )
  )
)

;; ================================================================
;; 四·五、图签 7 格（模型空间的独立 TEXT，不是块属性）
;; ================================================================
;; 实测口径（2026-09-20 量的，别凭记忆改）：
;;   · 图签 = 图框右下角一块 180x28 的格线块，参照插入点 = 图框右边界
;;     （第 n 框 x = (n-1)*470 + 415，y = 5）
;;   · 7 个格子文字是**模型空间的独立 TEXT**（图层 0、字高 3.5/4.0），
;;     每框各一份 —— 所以能逐框写不同内容（表头/柜块是共享定义，做不到）
;;   · 对齐正中（72=4 / 73=2），**组码 11 才是落点、且就是格子中心**；
;;     改字必须连组码 11 一起挪，否则字随字长漂
;;   · 格线块定义里 ATTDEF=0 —— 靠「无属性 + 180x28」认它，不靠块名
;;     （块名 11 是模板给的，换模板会变）

;; 块定义信息（带缓存） -> (ATTDEF数 宽 高 最小x 最小y)
;;   注意：返回的是 cdr(hit)，**没有块名那一项** —— 下标从 ATTDEF 数开始
(setq *plt:defcache* nil)
(defun plt:definfo (bn / hit e b ed ty q c px py x0 y0 x1 y1 na)
  (setq hit (assoc bn *plt:defcache*))
  (if hit
    (cdr hit)
    (progn
      (setq e (tblobjname "BLOCK" bn) na 0 x0 nil x1 nil y0 nil y1 nil)
      (if e
        (progn
          (setq b (entnext e))
          (while (and b (/= "ENDBLK" (cdr (assoc 0 (setq ed (entget b))))))
            (setq ty (cdr (assoc 0 ed)))
            (if (= ty "ATTDEF") (setq na (1+ na)))
            (foreach c (list 10 11)
              (setq q (assoc c ed))
              (if (and q (listp (cdr q)))
                (progn
                  (setq px (car (cdr q)) py (cadr (cdr q)))
                  (if (numberp px)
                    (progn
                      (if (or (null x0) (< px x0)) (setq x0 px))
                      (if (or (null x1) (> px x1)) (setq x1 px))
                      (if (or (null y0) (< py y0)) (setq y0 py))
                      (if (or (null y1) (> py y1)) (setq y1 py))
                    )
                  )
                )
              )
            )
            (setq b (entnext b))
          )
        )
      )
      (if (or (null x0) (null x1))
        (setq hit (list bn na 0.0 0.0 0.0 0.0))
        (setq hit (list bn na (- x1 x0) (- y1 y0) x0 y0))
      )
      (setq *plt:defcache* (cons hit *plt:defcache*))
      (cdr hit)
    )
  )
)

;; 图签格线块参照表 -> ((图元名 插入x 插入y) ...)，按 x 从左到右
(defun plt:tbscan ( / ss i n e ed bn di p out)
  (setq out nil)
  (setq ss (ssget "_X" '((0 . "INSERT") (410 . "Model"))))
  (if ss
    (progn
      (setq i 0 n (sslength ss))
      (while (< i n)
        (setq e (ssname ss i) ed (entget e) bn (cdr (assoc 2 ed)))
        (setq di (plt:definfo bn))
        (if (and (= (nth 0 di) 0)
                 (>= (nth 1 di) 175.0) (<= (nth 1 di) 185.0)
                 (>= (nth 2 di) 24.0) (<= (nth 2 di) 31.0))
          (progn
            (setq p (cdr (assoc 10 ed)))
            (setq out (cons (list e (car p) (cadr p)) out))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (vl-sort out '(lambda (a b) (< (cadr a) (cadr b))))
)

;; 文字落点：72/73 有非零时组码 11 才是落点，否则用组码 10
(defun plt:tbp (ed / j1 j2 q)
  (setq j1 (assoc 72 ed) j2 (assoc 73 ed))
  (if (and (assoc 11 ed)
           (or (and j1 (/= 0 (cdr j1))) (and j2 (/= 0 (cdr j2)))))
    (progn (setq q (cdr (assoc 11 ed))) (list (car q) (cadr q)))
    (progn (setq q (cdr (assoc 10 ed))) (list (car q) (cadr q)))
  )
)

;; 图签范围内的文字池 -> ((图元名 x y) ...)
(defun plt:tbpool (tx ty / ss i n e p out)
  (setq out nil)
  (setq ss (ssget "_X" '((0 . "TEXT") (410 . "Model"))))
  (if ss
    (progn
      (setq i 0 n (sslength ss))
      (while (< i n)
        (setq e (ssname ss i) p (plt:tbp (entget e)))
        (if (and p
                 (>= (car p) (- tx 182.0)) (<= (car p) (+ tx 2.0))
                 (>= (cadr p) (- ty 2.0)) (<= (cadr p) (+ ty 30.0)))
          (setq out (cons (list e (car p) (cadr p)) out))
        )
        (setq i (1+ i))
      )
    )
  )
  out
)

;; 文字池 -> ((槽位 . 图元名) ...)：先按格子矩形命中，再按格心就近（半径 15）
(defun plt:tbmap (pool tx ty / slots used cell key i it x y x0 x1 y0 y1
                             cx cy best bd d k)
  (setq slots nil used nil)
  (foreach cell *plt:tb-cells*
    (setq key (car cell) x0 (nth 1 cell) x1 (nth 2 cell)
          y0 (nth 3 cell) y1 (nth 4 cell) i 0 k nil)
    (while (and (< i (length pool)) (null k))
      (if (not (member i used))
        (progn
          (setq it (nth i pool) x (- (cadr it) tx) y (- (caddr it) ty))
          (if (and (>= x (- x0 0.5)) (<= x (+ x1 0.5))
                   (>= y (- y0 0.5)) (<= y (+ y1 0.5)))
            (setq k i)
          )
        )
      )
      (setq i (1+ i))
    )
    (if k
      (progn
        (setq slots (cons (cons key (car (nth k pool))) slots))
        (setq used (cons k used))
      )
    )
  )
  ;; 兜底：格心就近（文字落点会被 COM 挪动，实测最大漂 6.0）
  (foreach cell *plt:tb-cells*
    (setq key (car cell))
    (if (null (assoc key slots))
      (progn
        (setq cx (/ (+ (nth 1 cell) (nth 2 cell)) 2.0)
              cy (/ (+ (nth 3 cell) (nth 4 cell)) 2.0)
              best nil i 0)
        (while (< i (length pool))
          (if (not (member i used))
            (progn
              (setq it (nth i pool))
              (setq d (sqrt (+ (expt (- (- (cadr it) tx) cx) 2.0)
                               (expt (- (- (caddr it) ty) cy) 2.0))))
              (if (and (<= d 15.0) (or (null best) (< d bd)))
                (setq best i bd d)
              )
            )
          )
          (setq i (1+ i))
        )
        (if best
          (progn
            (setq slots (cons (cons key (car (nth best pool))) slots))
            (setq used (cons best used))
          )
        )
      )
    )
  )
  slots
)

;; 读一格文字的现值
(defun plt:tbg (e / ed)
  (setq ed (entget e))
  (if (assoc 1 ed) (cdr (assoc 1 ed)) "")
)

;; 写一格文字：值（组码 1）+ 落点（组码 11）；write=nil 只探测
(defun plt:tbput (e cx cy val write / ed)
  (if write
    (progn
      (setq ed (entget e))
      (if (assoc 1 ed)
        (setq ed (subst (cons 1 val) (assoc 1 ed) ed))
        (setq ed (append ed (list (cons 1 val))))
      )
      (if (assoc 11 ed)
        (setq ed (subst (cons 11 (list cx cy 0.0)) (assoc 11 ed) ed))
        (if (assoc 10 ed)
          (setq ed (subst (cons 10 (list cx cy 0.0)) (assoc 10 ed) ed))
        )
      )
      (entmod ed)
      (entupd e)
    )
  )
  T
)

;; 当天 YYYYMMDD（不开 menucmd，直接算，稳）
(defun plt:today ( / d y m dd)
  (setq d (fix (getvar "CDATE")))
  (setq y (/ d 10000))
  (setq m (/ (rem d 10000) 100))
  (setq dd (rem d 100))
  (strcat (itoa y) (if (< m 10) "0" "") (itoa m) (if (< dd 10) "0" "") (itoa dd))
)

;; 柜块参照的插入 x 表（靠「柜号」标签认柜，不认块名）
(defun plt:cabx ( / ss i n e ed out atts)
  (setq out nil)
  (setq ss (ssget "_X" '((0 . "INSERT") (410 . "Model"))))
  (if ss
    (progn
      (setq i 0 n (sslength ss))
      (while (< i n)
        (setq e (ssname ss i) atts (plt:atts e))
        (if (and atts (plt:val atts *plt:tag-cab*))
          (progn
            (setq ed (entget e))
            (setq out (cons (car (cdr (assoc 10 ed))) out))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  out
)

;; 工程号：日期段空 -> 前缀原样；`*` -> 前缀 + 当天；其余照拼
(defun plt:tbproj (pre d)
  (setq pre (if pre pre ""))
  (setq d (if d d ""))
  (if (= pre "")
    ""
    (if (= d "")
      pre
      (if (= d "*")
        (strcat pre (plt:today))
        (strcat pre d)
      )
    )
  )
)

;; 槽位键 -> 取值；nil = 这一格一个字都不写
(defun plt:tbval (key tb qty tot no pno / v)
  (cond
    ((= key "qty")   qty)
    ((= key "total") tot)
    ((= key "no")    no)
    (tb
     (cond
       ((= key "product") (setq v (nth 0 tb)))
       ((= key "title")   (setq v (nth 1 tb)))
       ((= key "code")    (setq v (nth 2 tb)))
       ((= key "project") (setq v pno))
       (T (setq v nil))
     )
     (if (null v) "" v))
    (T nil)
  )
)

;; 图签 7 格 -> 每套图框逐格写
;;   tb    = (柜型 图名 图号 工程号前缀 日期)；nil = 清单没写图签行
;;   write = nil 只算不写
;;   返回 (统计 说明文字)；统计 = (写了几格 实际变了几格 几套)
(defun plt:tbgo (tb write / refs cxs nref idx cnt chg it e e2 tx ty pool m
                              cell key cx cy val old ctl qty tot pno notb)
  (setq refs (plt:tbscan))
  (if (null refs)
    (list nil "  图签：图上没找到图签格线块（先跑 PGT 铺图），没动图。")
    (progn
      (setq cxs (plt:cabx))
      (setq nref (length refs))
      (setq idx 0 cnt 0 chg 0 ctl "")
      ;; 【2026-09-20 改】清单不写「图签」行时不再保留原值：柜型/图名/图号/
      ;;   工程号 4 格一律写空 —— 与 acad-mcp 的 frame_finish 同口径，免得
      ;;   图框模版里别人的预置值（GGD / 进线 D1 / QC… / JX01）被带出去。
      (setq notb (null tb))
      (if notb (setq tb (list "" "" "" "" "")))
      (setq pno (plt:tbproj (nth 3 tb) (nth 4 tb)))
      (foreach it refs
        (setq idx (1+ idx))
        (setq e (car it) tx (cadr it) ty (caddr it))
        (setq pool (plt:tbpool tx ty))
        (setq m (plt:tbmap pool tx ty))
        ;; 数量 = 【项目总柜数】（全图带「柜号」属性的柜块数）—— 2026-09-20 改：
        ;;   原按「本框柜数」逐框数；他纠为「直接填项目总柜数」，各框同值。
        (setq qty (strcat (itoa (length cxs)) "台"))
        (setq tot (itoa nref))
        (foreach cell *plt:tb-cells*
          (setq key (car cell))
          (setq cx (+ tx (/ (+ (nth 1 cell) (nth 2 cell)) 2.0)))
          (setq cy (+ ty (/ (+ (nth 3 cell) (nth 4 cell)) 2.0)))
          (setq val (plt:tbval key tb qty tot (itoa idx) pno))
          (if (not (null val))
            (progn
              (setq e2 (cdr (assoc key m)))
              (if e2
                (progn
                  (setq old (plt:tbg e2))
                  (plt:tbput e2 cx cy val write)
                  (setq cnt (1+ cnt))
                  (if (/= old val) (setq chg (1+ chg)))
                )
                (setq ctl (strcat ctl "第" (itoa idx) "套没配上[" key "]格 "))
              )
            )
          )
        )
      )
      (list
        (list cnt chg nref)
        (strcat "  图签 " (itoa nref) " 套 × 7 格：写 " (itoa cnt)
                " 格（变 " (itoa chg) " 格）"
                (if notb "  清单没写「图签」行 → 柜型/图名/图号/工程号 4 格已清空" "")
                (if (/= ctl "") (strcat SEP "    " ctl) ""))
      )
    )
  )
)

;; ================================================================
;; 五、主流程
;; ================================================================

;; 柜级 6 项（柜号由 PGT 写；这里值非空才写，空的保持原样）
(defun plt:cabfields () '("柜用途" "柜型" "柜尺寸" "容量功率" "分支电流" "备注"))

(defun plt:go (tx write / ps bus vol cabs warns pl map need pls nseg sc cabl hdrl have
                       sl key nm em cnt_cab cnt_slot cnt_hdr cnt_info
                       ncomp cno e atts cbm k val i emv missing cabs2 tbtxt
                       hdrs hi hh hb hv rw hm ex cex sd)
  (setq ps (plt:parse tx))
  (setq bus (car ps) vol (cadr ps) cabs (caddr ps) warns (cadddr ps)
        hdrs (nth 5 ps) sd (nth 6 ps))
  (cond
    ((null cabs)
     (strcat "清单里没解析出柜头行（柜头行必须以 @ 开头），没动图。" SEP
             (if warns (strcat "  " (car warns) SEP) "")))
    (T
     (setq sc (plt:scan) cabl (car sc) hdrl (cadr sc) have (caddr sc))
     (cond
       ((null cabl)
        "图上没找到柜块（先跑 PGT 铺图），没动图。")
       ((null hdrl)
        "图上没找到表头块（先跑 PGT 铺图），没动图。")
       (T
        ;; 图上没有的柜先剔掉再排槽 —— 否则它的元件照样占一个表头槽，
        ;; 排出来是没人用的幽灵槽（名称/型号写进表头，却没有柜用它）
        (setq missing "" cabs2 nil)
        (foreach cab cabs
          (if (assoc (nth 0 cab) cabl)
            (setq cabs2 (cons cab cabs2))
            (setq missing (strcat missing (nth 0 cab) " "))
          )
        )
        (setq cabs (reverse cabs2))
        (cond
         ((null cabs)
          (strcat "清单里的柜在图上一个都找不到（" missing "），没动图。"))
         (T
          ;; 排槽：清单里有几条表头行就是几段
          ;;   1 段 -> 老路 plt:plan（KYN28 不变）
          ;;   ≥2 段 -> 各段独立从第 1 槽起，槽数取两段较大者
          (setq nseg (length (plt:segs cabs)))
          (if (> nseg 1)
            (progn
              (setq pls (plt:planseg cabs sd) map nil need (plt:needseg pls))
            )
            (progn
              (setq pl (plt:plan cabs (plt:sdef-at sd 1))
                    map (car pl) need (cadr pl) pls nil)
            )
          )
          ;; 防呆：清单写了多遍表头行，却没有一段柜落在第 2 遍之后
          ;;   -> 这是【把表头行写在末尾】的旧写法，会静默退化成单段
          ;;      （两枚表头共用同一份槽位表、槽数变成两段之和）
          (if (and hdrs (> (length hdrs) 1) (= nseg 1))
            (setq warns (cons (strcat "清单写了 " (itoa (length hdrs))
                                      " 条表头行，却只切出 1 段 —— 表头行要写在"
                                      "【它那一段的柜之前】，段 = 该表头行之后、"
                                      "下一条表头行之前的柜") warns))
          )
          (setq ncomp 0)
          (foreach cab cabs (setq ncomp (+ ncomp (length (nth 7 cab)))))
          (cond
           ((> need have)
            (strcat "清单需要 " (itoa need) " 槽，图上只有 " (itoa have)
                    " 槽 —— 先用 PGT 按 " (itoa need) " 槽铺图，没动图。"))
           (T
            (setq cnt_cab 0 cnt_slot 0 cnt_hdr 0 cnt_info 0)
        (foreach cab cabs
          (setq cno (nth 0 cab))
          (setq e (cdr (assoc cno cabl)))
          (if (null e)
            (setq missing (strcat missing cno " "))
            (progn
              (setq atts (plt:atts e))
              ;; 柜级 6 项
              (setq i 0)
              (foreach val (plt:cabfields)
                (setq k (nth (+ i 1) cab))
                (if (and k (/= k ""))
                  (if (plt:put atts val k write) (setq cnt_cab (1+ cnt_cab)))
                )
                (setq i (1+ i))
              )
              ;; 槽位：1..have 每槽都写一遍，没数据的写空（幂等、不留残留）
              (setq cbm (plt:cabget cab map pls))
              (foreach k (plt:seq 1 have)
                (setq emv (assoc k cbm))
                ;; 规格：单行标签照旧写一行；加过行高的多行标签（规格1..M）
                ;;   按同一套宽度规则拆行分别落位（XBT 会先把行高加好）
                (setq rw (plt:putspec atts k (if emv (nth 3 (cdr emv)) "") write))
                (setq cnt_slot (+ cnt_slot (car rw)))
                ;; 槽的格数是两段取 max 定的：本柜只填满前 kk 行时，
                ;;   整组规格挪到槽的垂直中心（详见 plt:midrow）
                ;; ★ 只有真写才挪：dry 是只读预演，不能动图元
                (if (and write (caddr rw)) (plt:midrow e k (cadr rw) (caddr rw)))
                (if (plt:put atts (plt:tagk k "数量")
                             (if emv (nth 4 (cdr emv)) "") write)
                  (setq cnt_slot (1+ cnt_slot)))
                ;; 超宽提醒（规格栏 9.0 em）—— 只对单行槽位报；多行槽位本来就该超
                (if (and emv (= (cadr rw) 0)
                         (> (plt:em (nth 3 (cdr emv))) *plt:slot-col*))
                  (setq warns (cons (strcat cno " 元件" (itoa k) " 规格约 "
                                            (rtos (plt:em (nth 3 (cdr emv))) 2 1)
                                            " em，超过 " (rtos *plt:slot-col* 2 1)
                                            " —— 可能压出格子") warns))
                )
              )
            )
          )
        )
        ;; 表头：信息区与槽位表都按【从左到右第几枚】取 ——
        ;;   第 j 枚表头 <-> 清单第 j 条表头行 <-> 第 j 段
        ;;   （分段时各写各段；单段时三处共用同一份键表 = 老行为）
        (setq hi 0)
        (foreach e hdrl
          (setq hi (1+ hi) hb bus hv vol)
          (if (and hdrs (>= (length hdrs) 2))
            (progn
              (setq hh (nth (1- hi) hdrs))
              (if hh (setq hb (car hh) hv (cadr hh)))
            )
          )
          ;; 槽位表【各写各段】：分段时第 hi 枚表头只写第 hi 段的元件；
          ;;   单段时三处共用同一份（老行为）
          (setq hm (if pls (plt:maps pls hi) map))
          (setq atts (plt:atts e))
          (if (/= hb "")
            (if (plt:put atts *plt:tag-hdr* hb write) (setq cnt_info (1+ cnt_info)))
          )
          (if (/= hv "")
            (if (plt:put atts "电压等级" hv write) (setq cnt_info (1+ cnt_info)))
          )
          (foreach k (plt:seq 1 have)
            (setq key (plt:keyat hm k))
            (setq nm (if key (plt:bcut key 9) nil))
            (if (plt:put atts (plt:tagk k "名称") (if nm (car nm) "") write)
              (setq cnt_hdr (1+ cnt_hdr)))
            (if (plt:put atts (plt:tagk k "型号") (if nm (cadr nm) "") write)
              (setq cnt_hdr (1+ cnt_hdr)))
          )
        )
        (if (and pls (/= (length hdrl) nseg))
          (setq warns (cons (strcat "图上表头 " (itoa (length hdrl))
                                    " 枚，清单切出 " (itoa nseg)
                                    " 段 —— 对不上的表头槽位表会写空") warns))
        )
        ;; 图签 7 格（放在灌完柜数据之后 —— 数量格 = 项目总柜数，各框同值）
        (setq tbtxt (cadr (plt:tbgo (nth 4 ps) write)))
        ;; 报告
        (setq sl "")
        (if pls
          (progn
            (foreach ex pls
              (setq sl (strcat sl "段 " (itoa (car ex))
                               "（槽 " (itoa (caddr ex)) "）："))
              (foreach k (plt:seq 1 (caddr ex))
                (setq key (plt:keyat (cadr ex) k))
                (if key (setq sl (strcat sl (itoa k) "=" (car (plt:bcut key 9)) "  ")))
              )
              (setq sl (strcat sl SEP "    "))
            )
          )
          (foreach k (plt:seq 1 need)
            (setq key (plt:keyat map k))
            (if key
              (setq sl (strcat sl (itoa k) "=" (car (plt:bcut key 9)) "  "))
            )
          )
        )
        (strcat
          (if write "已填" "【只算没填】")
          "：柜 " (itoa (length cabs)) " 台 / 元件 " (itoa ncomp) " 条 / 槽位 "
          (itoa need) "（图上 " (itoa have) "）"
          (if (> nseg 1) (strcat "，分段 " (itoa nseg) "（各段独立编号）") "") SEP
          "  " (if write "实写" "将写")
          "：柜级 " (itoa cnt_cab) " 格，柜槽 " (itoa cnt_slot)
          " 格，表头槽 " (itoa cnt_hdr) " 格，表头信息 " (itoa cnt_info) " 格" SEP
          tbtxt SEP
          "  槽位分配：" sl SEP
          (if (/= missing "") (strcat "  图上找不到这些柜：" missing SEP) "")
          (if warns
            (strcat "  警告 " (itoa (length warns)) " 条：" SEP
                    (apply 'strcat (mapcar '(lambda (x) (strcat "    " x SEP)) warns)))
            "")
          (if write "  没存盘，改动都在内存里。" "")
          )
         )
        )
       )
      )
     )
    )
   )
  )
)

