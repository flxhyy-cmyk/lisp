;;; ================================================================
;;; 属性块-一键出图.lsp          命令：CZT
;;;   一份清单(txt) → 判型 → 铺壳 → 灌数 → 读回，一条命令跑完
;;; ----------------------------------------------------------------
;;; 本文件是【集成调度层】，不重复内核 —— 落地动作全部转发给原有工具：
;;;   铺壳 PGT  属性块-铺图.lsp        箱变 XBT  属性块-箱变.lsp
;;;   灌数 PLT  属性块-批量填数.lsp    改槽 GKC  属性块-槽位增减.lsp
;;;   行高 GGH  属性块-增加行高.lsp    图签 TQ   属性块-填图签.lsp
;;;   元件 JYJ  属性块-增加元件.lsp    柜宽 GKW  属性块-柜宽缩放.lsp
;;;   换槽 CWJH 属性块-槽位顺序.lsp
;;;   按名自动 load：同目录 → 环境变量 CAD_LISP_BASE\lisp → 固定回退路径
;;; ----------------------------------------------------------------
;;; 用法（★ AutoLISP 没有可选参数，少给一个会报「参数太少」）：
;;;   命令 CZT                      打开交互入口（对话框）：
;;;                                   · 「粘贴剪贴板清单 → 一键出图」——
;;;                                     配套的「箱变生成器」「KYN28 生成器」
;;;                                     网页点「写回」会自动把清单复制到
;;;                                     剪贴板（也认手工在别处按同格式复制的
;;;                                     文本），点这个按钮直接出图；
;;;                                   · 「改从 TXT 文件读取…」—— 老的选文件流程；
;;;                                   ★ 出图一律在对话框关掉之后执行：DCL 打开时
;;;                                     跑 command 会取不到输入，把 CAD 卡死。
;;;                                   两个入口都能勾选「只预演」「先清空重铺」、
;;;                                   或强制指定 KYN28 / 箱变两段。
;;;   (czt:auto "D:/x/清单.txt")    给路径、自动判型；返回回包字符串
;;;   (czt:go "路径" nil)           同上（mode 必给：nil = 自动判型）
;;;   (czt:go 路径 "kyn28")         强制 KYN28（PGT 铺壳）
;;;   (czt:go 路径 "xbw")           强制箱变两段（XBT 铺壳）
;;;   (czt:dry 路径)                只预演，不写图
;;;   (czt:go 路径 "wipe")          先 ERASE 当前空间再重铺（危险，必须显式写）
;;;   (czt:text "清单文本" nil)      直接吃文本，不落文件（对话框「粘贴」按钮走这条）
;;;   转发：czt:slot / czt:row / czt:title / czt:add / czt:width / czt:swap
;;; ----------------------------------------------------------------
;;; 规矩：不存盘、不截图；脏图（图上已有柜块）默认拒跑
;;; 判型：清单里「表头」行 >= 2 条 → 箱变两段；否则 KYN28
;;; 本文件编码 ANSI/GBK，无 BOM；
;;; 清单 txt 支持 GBK 与 UTF-8（含/不含 BOM）—— 自动判，不用手动转存
;;; 本文件是【单文件集成版】：把铺图 PGT / 箱变 XBT / 批量填数 PLT /
;;; 槽位增减 GKC / 增加行高 GH 五个依赖模块的源码全部原样并入本文件，
;;; 只用这一个 .lsp 即可运行，不再需要同目录放另外五个文件。
;;; ================================================================
(vl-load-com)

(if (not (boundp 'SEP)) (setq SEP (chr 10)))

;; 回包累积器：czt:say 既打印也累积，入口最后把它当返回值吐出来
(setq *czt:out* "")

;; ================================================================
;; 一、小工具
;; ================================================================

(defun czt:flat (s)
  (if (/= (type s) 'STR) (setq s (vl-princ-to-string s)))
  (if s s "")
)

;; 打印一段回包 + 记进 *czt:out*（多行照打）
(defun czt:say (s / t2)
  (setq t2 (czt:flat s)
        *czt:out* (strcat *czt:out* t2 SEP))
  (princ (strcat SEP t2))
  (princ)
)

;; ----------------------------------------------------------------
;; 读清单文件：GBK / UTF-8（含无 BOM）自适应
;;   判据 = 清单里必有中文关键词「表头」「图签」——
;;   编码用错时这两个词一定解不出来（实测：GBK 文件按 utf-8 读，
;;   两个词全不命中；utf-8 文件按 utf-8 读命中）。
;;   ADODB 读完由 COM 转成系统 ANSI(GBK) 字节串，与 plt:readfile
;;   同一条码路，可以直接喂 plt:run / pgt:run / xbt:run。
;;   纯 ASCII 清单两种解码等价，兜底走 plt:readfile。
;; ----------------------------------------------------------------

;; 按指定 Charset 读文件（COM 不可用 / 读失败返回 nil）
(defun czt:rd1 (f cs / s txt)
  (setq s (vl-catch-all-apply 'vlax-create-object (list "ADODB.Stream")))
  (if (vl-catch-all-error-p s)
    nil
    (progn
      (vl-catch-all-apply 'vlax-put (list s 'Type 2))
      (vl-catch-all-apply 'vlax-put (list s 'Charset cs))
      (vl-catch-all-apply 'vlax-invoke (list s 'Open))
      (vl-catch-all-apply 'vlax-invoke (list s 'LoadFromFile f))
      (setq txt (vl-catch-all-apply 'vlax-invoke (list s 'ReadText -1)))
      (vl-catch-all-apply 'vlax-invoke (list s 'Close))
      (if (or (vl-catch-all-error-p txt) (null txt) (= txt "")) nil txt)
    )
  )
)

;; 解得对不对：清单一定有「表头」或「图签」
(defun czt:okp (s)
  (and (= (type s) 'STR)
       (or (vl-string-search "表头" s) (vl-string-search "图签" s)))
)

;; 清单文件 -> 文本（自适应编码；COM 不可用退回 plt:readfile 的 GBK 路）
(defun czt:readfile (f / tx)
  (setq tx (czt:rd1 f "utf-8"))
  (if (czt:okp tx)
    tx
    (progn
      (setq tx (czt:rd1 f "gb2312"))
      (if (not (czt:okp tx)) (setq tx (plt:readfile f)))
      tx
    )
  )
)

;; ================================================================
;; 二、依赖：按名找 lsp 并 load
;; ================================================================

(defun czt:ld (n / f d p)
  (setq f (findfile (strcat n ".lsp")))
  (if (null f)
    (progn
      (setq d (getenv "CAD_LISP_BASE"))
      (if (or (null d) (= d "")) (setq d "D:/kk三部曲/148.CAD插件研究"))
      (setq f (findfile (strcat d "/lisp/" n ".lsp")))
    )
  )
  (if (null f)
    (setq f (findfile (strcat "D:/kk三部曲/148.CAD插件研究/lisp/" n ".lsp")))
  )
  (if f
    (progn
      (setq p (vl-catch-all-apply 'load (list f)))
      (not (vl-catch-all-error-p p))
    )
    nil
  )
)

;; 函数在不在（atoms-family 两种口径都试，避免符号/字符串比较踩空）
(defun czt:has (n / af)
  (setq af (atoms-family 0))
  (if (or (member n af) (member (read n) af)) T nil)
)

;; 缺哪个补哪个；返回 T，或缺失文件名单（前带空格）
(defun czt:ensure ( / miss m)
  (setq miss "")
  (foreach m '(("PLT:PLAN"    . "属性块-批量填数")
               ("PGT:INS"     . "属性块-铺图")
               ("GKC:REBUILD" . "属性块-槽位增减")
               ("GH:APPLY"    . "属性块-增加行高")
               ("XBT:GO"      . "属性块-箱变"))
    (if (not (czt:has (car m)))
      (if (null (czt:ld (cdr m)))
        (setq miss (strcat miss " " (cdr m)))
      )
    )
  )
  (if (= miss "") T miss)
)

;; 单个模块按需 load（转发族用）
(defun czt:req (fn sym)
  (if (not (czt:has sym)) (czt:ld fn))
  (czt:has sym)
)

;; ================================================================
;; 三、清单解析（只读文本，不改图）
;; ================================================================

;; 模式串 -> 标志表（KYN28 / XBW / DRY / WIPE）
(defun czt:fl (s / u out p)
  (setq u (strcase (if s s "")) out nil)
  (foreach p '("KYN28" "XBW" "BOX" "DRY" "WIPE")
    (if (vl-string-search p u) (setq out (cons p out)))
  )
  (setq out (reverse out))
  (if (member "BOX" out) (setq out (cons "XBW" (vl-remove "BOX" out))))
  out
)

;; 是否注释行（# 或 // 开头，与 plt:parse 的跳过规则同口径 ——
;;   箱变/KYN28 两个网页生成器"写回"时会在清单末尾附一段
;;   "# 槽位顺序（…，仅供核对）" 块，靠这条规则不会被误认成
;;   表头行或柜头行；注意该块同时也是【排槽定义来源】，
;;   由 plt:sdefs 单独解析，不是纯注释）
(defun czt:cmt? (ln) (or (plt:pfx ln "#") (plt:pfx ln "//")))

;; 「表头」行条数 = 段数（跳过注释行）
(defun czt:hdrn (tx / n ln fs)
  (setq n 0)
  (foreach ln (plt:lines tx)
    (if (not (czt:cmt? ln))
      (progn
        (setq fs (plt:fields ln))
        (if (and fs (equal (car fs) "表头")) (setq n (1+ n)))
      )
    )
  )
  n
)

;; 柜号表（@柜头行第一段去掉 @；跳过注释行）
(defun czt:cabs (tx / out ln c)
  (setq out nil)
  (foreach ln (plt:lines tx)
    (if (not (czt:cmt? ln))
      (progn
        (setq c (car (plt:fields ln)))
        (if (and c (= (substr c 1 1) "@") (> (strlen c) 1))
          (setq out (cons (substr c 2) out))
        )
      )
    )
  )
  (reverse out)
)

;; ================================================================
;; 四、图上体检 / 清图
;; ================================================================

;; 图上柜块参照数（口径同 flow.py：块名含「柜块模版」或就是「开关柜」）
(defun czt:oncab ( / ss n i e bn c)
  (setq c 0 ss (ssget "_X" '((0 . "INSERT") (410 . "Model"))))
  (if ss
    (progn
      (setq n (sslength ss) i 0)
      (while (< i n)
        (setq bn (cdr (assoc 2 (entget (ssname ss i)))))
        (if (and bn (or (vl-string-search "柜块模版" bn) (= bn "开关柜")))
          (setq c (1+ c))
        )
        (setq i (1+ i))
      )
    )
  )
  c
)

;; 清空当前空间（危险：只在显式 "wipe" 时走）
(defun czt:wipe ( / ss)
  (setq ss (ssget "_X"))
  (if ss
    (progn
      (vl-catch-all-apply 'vl-cmdf (list "_.ERASE" ss ""))
      (czt:say "  [wipe] 已清空当前空间，准备重铺。")
    )
    (czt:say "  [wipe] 当前空间本来就是空的。")
  )
  (princ)
)

;; ================================================================
;; 五、主流程
;; ================================================================

;; 回包走 *czt:out*，末尾返回它（可与 princ 并行：命令行能看，程序能抓）
(defun czt:ex (tx src mode / fl dry wp kw hd need cabs cc r1 r2 sc res ok)
  (setq *czt:out* "")
  (setq fl  (czt:fl mode)
        dry (if (member "DRY" fl) T nil)
        wp  (if (member "WIPE" fl) T nil))
  (setq hd   (czt:hdrn tx))
  (setq kw   (cond ((member "XBW" fl)   "XBW")
                   ((member "KYN28" fl) "KYN28")
                   ((>= hd 2)           "XBW")
                   (T                   "KYN28")))
  (setq cabs (czt:cabs tx))
  (if cabs (setq need (plt:need tx)))
  (setq cc   (czt:oncab))

  (czt:say (strcat "===== 一键出图 CZT =====" SEP
                   "  清单：" (if src src "（直接给的文本）") SEP
                   "  判型：" (if (= kw "XBW") "箱变两段 → XBT" "KYN28 → PGT")
                   (cond (dry "    [DRY 预演]") (wp "    [WIPE 先清图]") (T "")) SEP
                   "  清单：" (itoa (length cabs)) " 台柜 / " (itoa hd) " 条表头行 / 需 "
                            (itoa (if need need 0)) " 槽" SEP
                   "  图上：柜块 " (itoa cc) " 个"))

  (cond
    ((null cabs)
     (czt:say "[CZT] 清单里没解析出柜头行（柜头行必须以 @ 开头），没动图。"))
    ((and (not dry) (> cc 0) (not wp))
     (czt:say (strcat "[CZT] 脏图拒跑：图上已有 " (itoa cc) " 个柜块（柜块模版-* / 开关柜）。"
                      SEP "       换干净图重跑；确实要清图重铺 → (czt:go \"路径\" \"wipe\")"
                      SEP "       没动图。")))
    (T
     (if wp (czt:wipe))
     (if dry
       (progn
         (czt:say "—— 预演（不写图）——")
         (if (= kw "XBW") (czt:say (xbt:dry tx)) (czt:say (pgt:dry need cabs)))
         (if (> cc 0)
           (czt:say (plt:dry tx))
           (czt:say "（空图：PLT 预演跳过 —— 它要先有柜块才算得出灌数；正式跑会先铺壳再灌数）")
         )
         (czt:say "== 预演结束，图没动 ==")
       )
       (progn
         (czt:say (strcat "—— 1/3 铺壳 " (if (= kw "XBW") "XBT（箱变两段）" "PGT") " ——"))
         (setq r1 (if (= kw "XBW") (xbt:run tx) (pgt:run need cabs)))
         (czt:say r1)
         (czt:say "—— 2/3 灌数 PLT（柜数据 + 表头 + 图签）——")
         (setq r2 (plt:run tx))
         (czt:say r2)
         (setq sc  (plt:scan)
               res (list (length (car sc)) (length (cadr sc)) (caddr sc)))
         (setq ok  (and (= (car res) (length cabs)) (= (caddr res) (if need need 0))))
         (czt:say (strcat "—— 3/3 读回 ——" SEP
                          "  图上：柜 " (itoa (car res)) " 台 / 表头 " (itoa (cadr res))
                          " 枚 / 槽位 " (itoa (caddr res)) SEP
                          "  期望：柜 " (itoa (length cabs)) " 台 / 槽位 " (itoa (if need need 0)) SEP
                          "  结果：" (if ok "OK 对齐" "CHECK 对不上，看上面回包")))
       )
     )
    )
  )
  *czt:out*
)

;; 给文件路径
(defun czt:go (f mode / tx mm)
  (setq *czt:out* "")
  (if (czt:dcl-open?)
    (czt:say "[CZT] 对话框还开着，拒绝出图（DCL 状态下跑 command 会把 CAD 锁死）。先关掉对话框再试。")
  (if (or (null f) (= f ""))
    (czt:say "[CZT] 没给清单路径。用法 (czt:go \"D:/x/清单.txt\")。")
    (progn
      (setq mm (czt:ensure))
      (if (/= mm T)
        (czt:say (strcat "[CZT] 缺工具文件（同目录没找到）：" mm
                         SEP "       没动图。"))
        (progn
          (setq tx (czt:readfile f))
          (if (null tx)
            (czt:say (strcat "[CZT] 读不到这个文件：" f))
            (czt:ex tx f mode)
          )
        )
      )
    )
  )
  )
  *czt:out*
)

;; 只给路径（mode = nil，自动判型）—— 一参快捷入口
