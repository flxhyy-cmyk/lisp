;;; ============================================================
;;; 属性块-增加行高.lsp                                      命令：GGH
;;; ------------------------------------------------------------
;;; 作用
;;;   某个槽的「规格」一行写不下（如变压器 35 字），把这一槽在行区
;;;   里加高 M 行 —— 全排（柜块 + 表头块）的同一个槽统一变高。
;;;   槽号不动、槽数不动，块只往下长。
;;;
;;; 为什么要单独一个文件
;;;   「槽位增减」(GKC) 管【槽数】，「增加行高」管【单槽几行】，是
;;;   两件事。填数方算出行数后要「先加高、后写值」，这一步需要能
;;;   单独调用，故独立成命令。
;;;   重建内核（克隆定义 / 重造参照 / 元数据维护）完全复用 GKC ——
;;;   见 gh:ensure，本文件会自己把 GKC load 进来。
;;;
;;; 与 GKC 的关键差别（别混）
;;;   GKC 加槽：在行区【底部】加全新的槽（槽号 +1、标签整体换号）。
;;;   GGH 加行：在【某个已有槽的内部】加行（槽号不变，标签由
;;;             元件NN规格 长成 元件NN规格1 / 规格2 …）。
;;;
;;; 几何口径（全部实测得来，不写死数字）
;;;   ① 槽 01 在最上、maxn 在最下，槽间距 P，行区底线 B。
;;;   ② 加行是【向下长】：槽 s 的第 1 行原地不动，长出来的行把槽 s
;;;      以下的一切（更靠下的槽 / 底部区 / 柜框底边）整体往下推，
;;;      块顶不动 —— 块因此变高；而铺图按【几何顶】对位，所以柜顶
;;;      位置不变。
;;;   ③ 块定义是【全排共享】的：改一个槽 = 本排所有参照（柜块与
;;;      表头块）这一槽一起变高。这就是"统一增加" —— 不需要、也
;;;      没法只改某一个参照。
;;;   ④ 表头块没有「规格」属性：行数【数不出来】（gh:cur 恒 0），所以
;;;      它不自己算，一律沿用柜块算出的整排基准 da —— 只跟着长行格、
;;;      不添字（见 gh:baseda）。第一遍加行时表头自算恰好等于真值，
;;;      再调一次就会多长一遍，这是必须避开的地方。
;;;      两段因此天然等高，不用配平。
;;;
;;; ★ 统一变换（一条公式管住全部图元类型）
;;;   一个点的下移量 = Σ(下边界 >= y 的各槽的加行数) * P
;;;   其中 槽 s 的下边界 = B + (maxn - s) * P
;;;   用 >= 而不是 > 是关键：正好压在下边界上的横线（还有行区底线
;;;   上的分栏竖线下端）必须把自己那一槽的加行量也一起算，否则它会
;;;   比新底线高出一行。槽属性自身 y = 下边界 + off（off>0），不受
;;;   这条影响。
;;;   （加高时不新增横线：槽内不画分隔线，只补「规格N」属性。）
;;;   ⑤ 加高槽里【没分行的数据】（数量 / 名称 / 型号）垂直居中：
;;;      槽变高后槽顶不动、槽底往下 dy*P，槽的垂直中点就下移 dy*P/2。
;;;      这些单行数据 = 先随槽按统一公式下移（gh:sh），再额外下移
;;;      dy*P/2（gh:shdn），保持它在格里原来的相对位置，所以不管
;;;      对正方式是基线 / 中间 / 顶，都仍然居中。规格类不居中 ——
;;;      它本来就按行一格格往下排。
;;;   一条公式同时管住：槽属性 / 行区横线 / 竖线两端 / 柜参数区 /
;;;   底部区 / 柜框矩形（底边下移、顶边不动 = 自动变高）。
;;;
;;; 三个入口
;;;   ① 手动：命令 GGH —— 点本排任一属性块，输入每槽行数（逗号
;;;      分隔，如 1,1,1,1,1,3,1；回车 = 全 1）。
;;;   ② 被填数方调用：
;;;        (gh:apply "句柄,句柄" "1,1,1,1,1,3,1,1")  批量，一次到位
;;;        (gh:slot  "句柄,句柄" 6 3)                单槽：第 6 槽变 3 行
;;;        (gh:dry   "句柄,句柄" "1,1,1,1,1,3,1,1")  只读预演，图不动
;;;   ③ 返回 (报告 参照映射 定义映射)，与 gkc:expand 同形；报告头
;;;      带 [GGH-RESULT] 与 |@defs / |@refs / |@bad 机器段。
;;;
;;; ★ 句柄会变
;;;   重建后参照被重造（本机 COM 无 AddAttribute，只能靠 _. -INSERT
;;;   让 CAD 自己实例化属性），句柄全变 —— 所以【先加高、再填值】
;;;   时，填值方要用返回的新句柄。要加多个槽就一次把 plan 传完，
;;;   别循环调 gh:slot（每调一次句柄变一轮）。
;;;
;;; 编码：ANSI/GBK 无 BOM
;;; 依赖：属性块-槽位增减.lsp（内核），本文件会自动 load
;;; ============================================================
(vl-load-com)
(if (null SEP) (setq SEP (chr 10)))

;; ---------------- 依赖（槽位增减的内核） ----------------
(setq gh:dep "D:/kk三部曲/148.CAD插件研究/lisp/属性块-槽位增减.lsp")

;; 内核不在就 load 一次。返回 T / nil。
;;   ★ 不在这里 princ：MCP 口是拿 vl-princ-to-string 把结果整串回传的，
;;     中途 princ 会污染回包；要报错由调用方报。
(defun gh:ensure ( / p)
  (if gkc:rebuild
    T
    (progn
      (setq p (vl-catch-all-apply 'load (list gh:dep)))
      (if (and (not (vl-catch-all-error-p p)) gkc:rebuild) T nil)
    )
  )
)

;; ================================================================
;; 一、行数：计划 / 现状
;; ================================================================

;; 槽 n 的目标行数；plan 可以是表 (1 3 1)、逗号串 "1,3,1"、或 nil（全 1）
(defun gh:at (plan n / v)
  (cond
    ((null plan) 1)
    ((listp plan)
     (setq v (nth (1- n) plan))
     (if (and v (numberp v) (> v 0)) (fix v) 1))
    (T
     (setq v (nth (1- n) (gkc:tokens plan)))
     (if v (max 1 (atoi v)) 1))
  )
)

;; 该槽现在占几行（数 元件NN规格 / 规格1 / 规格2 …）
;;   表头块的槽位是「名称 / 型号」，没有规格属性 —— 数出来恒为 0。
;;   所以调用方必须自己取【max 1 _】：表头也是"本来就有 1 行"，
;;   只是没有规格属性可以数（见 gh:rebuild 里的注释）。
(defun gh:cur (bn n / k ed sfx)
  (setq k 0)
  (foreach ed (gkc:attdefs bn)
    (if (= (gkc:slotno (cdr (assoc 2 ed))) n)
      (progn
        (setq sfx (gkc:suffix (cdr (assoc 2 ed))))
        (if (= (substr sfx 1 4) "规格") (setq k (1+ k)))
      )
    )
  )
  k
)

;; 某个块定义按行计划要加几行 -> ((槽号 . 加行数) ...)，没有要加的 nil
(defun gh:deltas (bn plan / g0 sls s da n dy)
  (setq g0 (gkc:geo bn))
  (if (null g0)
    nil
    (progn
      (setq sls (nth 3 g0) da nil)
      (foreach s sls
        (setq n (car s)
              ;; 现状行数【下限是 1】：表头块没有「规格」属性（gh:cur 恒 0），
              ;; 但它的槽本来就有 1 行 —— 直接拿 gh:cur 当现状，表头就会按
              ;; 「从 0 行加到 N 行」算，9 个槽全被加满（Σ=12 行），整块被撑爆。
              ;; 表头要的正是「只长行格、不添字」：行数跟柜块一样多。
              dy (- (gh:at plan n) (max 1 (gh:cur bn n))))
        (if (> dy 0) (setq da (cons (cons n dy) da)))
      )
      (reverse da)
    )
  )
)

;; 块定义有没有「规格」类槽位属性
;;   柜块有（规格 / 规格1…），表头块没有（它的槽位是 名称 / 型号）。
;;   这个区别很关键：gh:cur 数不出表头的行数（恒 0），所以表头不能
;;   自己算 da，必须沿用柜块的 —— 见 gh:baseda。
;;   ★ 必须先判 gkc:slotno 非 nil（也就是 tag 是「元件NN…」）：
;;     表头块有个「主母线规格」属性，而 gkc:suffix 是「从第 7 字节截到
;;     尾」—— 主母线规格 正好 10 字节，截完剩「规格」两个字，于是不判
;;     槽号就会把表头当成"有规格的块"，基准 da 取错、整排多长一遍。
;;     （gh:cur 里有槽号判断所以没中招，这里一开始漏了。）
(defun gh:hasspec (bn / ed tg r)
  (setq r nil)
  (foreach ed (gkc:attdefs bn)
    (setq tg (cdr (assoc 2 ed)))
    (if (and (gkc:slotno tg) (= (substr (gkc:suffix tg) 1 4) "规格"))
      (setq r T))
  )
  r
)

;; 整排的基准加行表 -> (找到了吗 da表)
;;   ★ 为什么不能逐块自算：
;;     表头块没有「规格」属性 -> gh:cur 恒 0 -> 它按「从 0 行加到 N 行」
;;     算，比真值大。第一遍加行时两者恰好相等（柜块也从 0 起），所以
;;     第一遍看不出问题；再调一次就露馅：柜块 dy=0 不动，表头又加一遍，
;;     整排被拉成不等高。
;;   ★ 口径：全排统一 —— 拿【有规格属性的块】（柜块）算出来的 da 当作
;;     整排基准，表头照它执行。柜块能数准，两段又同步，所以表头与柜块
;;     永远等高（这正是"表头高度由槽数定义"的落地方式）。
;;   整排一个能数的块都没有（纯表头排）-> (nil nil)，退回逐块自算。
(defun gh:baseda (gs plan / da g found)
  (setq da nil found nil)
  (foreach g gs
    (if (and (null found) (gh:hasspec (car g)))
      (progn (setq da (gh:deltas (car g) plan) found T))
    )
  )
  (list found da)
)

;; 整排加行计划的总加行数（用于算块底下移 / 新块高）
(defun gh:sig (da / s t2)
  (setq t2 0)
  (foreach s da (setq t2 (+ t2 (cdr s))))
  t2
)

;; ================================================================
;; 二、统一变换（把「加几行」落到每个点上）
;; ================================================================

;; 点 y 的下移量（统一公式）
;;   bots = 每槽【实测底线】((槽号 . 底线y) ...)，块定义坐标
;;   ★ 不能再按 B + P*(maxn-s) 现推：那条式子暗含「每槽都是 1 行」，
;;     块一旦加过行（槽6 三行 / 槽1 两行），推出的底线整体偏低，
;;     居中会连带偏掉（2026-09-20 实测：数量少抬 1.5）。
(defun gh:dy (y bots P da / tot s dl)
  (setq tot 0.0)
  (foreach s bots
    (setq dl (cdr (assoc (car s) da)))
    (if (and dl (> dl 0) (>= (cdr s) (- y 1e-6)))
      (setq tot (+ tot (* P dl))))
  )
  tot
)

;; 按统一公式平移一个实体的所有 10/11 点
(defun gh:sh (ed bots P da / out q pt)
  (setq out nil)
  (foreach q ed
    (if (and (member (car q) '(10 11)) (listp (cdr q)) (numberp (car (cdr q))))
      (progn
        (setq pt (cdr q))
        (setq out (cons (cons (car q)
                              (gkc:setY pt (- (cadr pt)
                                              (gh:dy (cadr pt) bots P da))))
                         out)))
      (setq out (cons q out))
    )
  )
  (reverse out)
)

; 每槽【实测底线】-> ((槽号 . 底线y) ...)，块定义坐标
;;   sls = gkc:slots 的结果 ((槽号 最小属性y ATTDEF表) ...)
;;   ★ 属性 y = 格底 + 半字高（原块的设计就是「文字在格内垂直居中」，
;;     不是贴格底）—— 所以 底线 = 该槽最小属性 y - 半字高。
(defun gh:bots (sls / r h)
  (setq r nil)
  (foreach s sls
    (setq h (cdr (assoc 40 (car (caddr s)))) h (if h h 3.0))
    (setq r (cons (cons (car s) (- (cadr s) (/ h 2.0))) r))
  )
  (reverse r)
)

;; 把实体的 10/11 点 y 整体再下移 d（两点同量，10/11 的相对关系不变）
;;   ★ 居中不能「直接把 10/11 都设成同一个 y」：对正不是基线时，
;;     实际落点由 11 点（对齐点）决定，10 点只是左基线，两者本来就差
;;     约半个字高；都设成同一值会让文字整体偏 h/2（中间对正）或 h（顶对正）。
(defun gh:shdn (ed d / out q)
  (setq out nil)
  (foreach q ed
    (if (and (member (car q) '(10 11)) (listp (cdr q)) (numberp (car (cdr q))))
      (setq out (cons (cons (car q) (gkc:setY (cdr q) (- (cadr (cdr q)) d))) out))
      (setq out (cons q out))
    )
  )
  (reverse out)
)

;; meta 的 slotrows= 重写成新的完整列表（槽数没变，只换每槽行数）
(defun gh:meta (desc plan maxn / r sp v i)
  (setq r desc)
  (if (and r (/= r ""))
    (progn
      (setq sp (gkc:kvspan r "slotrows="))
      (if sp
        (progn
          (setq v "" i 1)
          (while (<= i maxn)
            (setq v (strcat v (if (= v "") "" ",") (itoa (gh:at plan i))))
            (setq i (1+ i))
          )
          (setq r (strcat (substr r 1 (1- (car sp))) v (substr r (cadr sp))))
        )
      )
    )
  )
  r
)

;; 把参照上某槽的属性 tag 从 oldsfx 改成 newsfx（只动组码 2：迁值按 tag 认）
;;   gkc:newref 迁值是「按 tag 配对」的 —— 定义侧把 元件NN规格 改成了
;;   元件NN规格1，参照这一侧不跟着改，值就会静默丢掉。失败要能改回来，
;;   所以 old / new 都给。
(defun gh:relabel (e da oldsfx newsfx / sub ed tg n nt d2)
  (setq sub (entnext e))
  (while (and sub (= "ATTRIB" (cdr (assoc 0 (setq ed (entget sub))))))
    (setq tg (cdr (assoc 2 ed)) n (gkc:slotno tg))
    (if (and n (= (gkc:suffix tg) oldsfx) (cdr (assoc n da)))
      (progn
        (setq nt (gkc:mktag n newsfx) d2 nil)
        (foreach q ed
          (setq d2 (cons (if (= (car q) 2) (cons 2 nt) q) d2))
        )
        (entmod (reverse d2))
      )
    )
    (setq sub (entnext sub))
  )
)

;; ================================================================
;; 三、重建定义（槽号、槽数都不变，只让指定槽变高）
;; ================================================================

;; 返回 (新定义名 da表)；没有要改的槽 -> nil
;;   da0 = 'AUTO 自算 / 一张 da 表（整排基准，见 gh:baseda）/
;;         nil（整排都不用动，直接判无变化）
(defun gh:rebuild (bn newbn plan da0 / g0 B P maxn sls da addl bh base flags desc hb
                     ed d2 d3 s n dy tg hing y0 y0p j nt c0 yb mid
                     bots)
  (setq g0 (gkc:geo bn))
  (if (null g0) nil
    (progn
      (setq B (car g0) P (cadr g0) maxn (caddr g0) sls (nth 3 g0))
      ;; 每槽底线由属性反推，只用来给各点分「下移档」（gh:dy）。
      ;; 这样块加过行之后再改 plan 也不会算错（旧写法按「每槽 1 行」现推）。
      ;; 居中不再依赖它（见下面 gh:shdn）。
      (setq bots (gh:bots sls))
      (setq da (if (eq da0 'AUTO) (gh:deltas bn plan) da0))
      (if (null da) nil
        (progn
          ;; --- 备好要新增的实体 ---
          (setq addl nil)
          (foreach s sls
            (setq n (car s) dy (cdr (assoc n da)))
            (if (and dy (> dy 0))
              (progn
                ;; ① 槽内【不再】新增横线（加高只让槽变高、只补规格属性）。
                ;;   这里只算两个基准供下面 ② 定位新属性用：
                ;;   y0  = 该槽原下边界；y0p = 该槽加高后的新下边界
                (setq y0 (cdr (assoc n bots)))
                (setq y0p (- y0 (gh:dy y0 bots P da)))
                ;; ② 槽的「规格」属性复制 dy 份（表头块没有规格 -> 只长格不添字）
                ;;   ★ hing 取【规格类属性里最靠上的那个】（y 最大），不能只认
                ;;     后缀恰好等于「规格」：槽一旦加过行，属性就叫 规格1 /
                ;;     规格2 / 规格3，单行的「规格」不复存在 —— 只认它就会
                ;;     一个也找不到，于是行格长了、属性却没补，槽里永远少最后
                ;;     一行（2026-09-20 实测：槽6 加高后只有 规格1/2/3）。
                (setq c0 (max 1 (gh:cur bn n)))
                (setq hing nil yb -1e99)
                (foreach ed (caddr s)
                  (setq tg (cdr (assoc 2 ed)))
                  (if (and (= (substr (gkc:suffix tg) 1 4) "规格")
                           (> (caddr (assoc 10 ed)) yb))
                    (progn (setq hing ed) (setq yb (caddr (assoc 10 ed)))))
                )
                (if hing
                  (progn
                    (setq j 0)
                    (while (< j dy)
                      (setq j (1+ j))
                      ;; 位移一次算到【最终坐标】：gkc:mkat 的相对位移是按原
                      ;; 几何加的，而 addl 里的实体不再过 gh:sh，所以必须自己
                      ;; 把全局下移量算进去。
                      ;;   hing 是本槽【顶行】那个规格属性（第 1 行）。设它原有
                      ;;   y = y0+off，它自己的下移量 = rowdy(y0+off)，而
                      ;;   rowdy(y0) = rowdy(y0+off) + dy*P（y0 比顶行低，多含
                      ;;   本槽自己），于是 rowdy(y0+off) = (y0 - y0p) - dy*P。
                      ;;   新属性是【第 (c0+j) 行】：第 m 行的 y = 顶行y - P*(m-1)。
                      ;;   合计相对位移 = -rowdy(y0+off) - P*(c0+j-1)
                      ;;                = (y0p - y0) + P*(dy - (c0+j-1))
                      ;;   c0=1 时退化成原来的 P*(dy-j) —— 与首轮加行逐字等价。
                      ;;   j=dy 时落在本槽新底线之上（底线+off）。
                      (setq d2 (gkc:mkat hing n (+ (- y0p y0)
                                                   (* P (- dy (- (+ c0 j) 1))))))
                      (setq nt (gkc:mktag n (strcat "规格" (itoa (+ c0 j)))))
                      (setq d3 nil)
                      (foreach q d2
                        (setq d3 (cons (if (member (car q) '(2 3)) (cons (car q) nt) q) d3))
                      )
                      (setq addl (cons (reverse d3) addl))
                    )
                  )
                )
              )
            )
          )
          ;; --- 重建定义 ---
          (setq bh (entget (tblobjname "BLOCK" bn)))
          (setq base (cdr (assoc 10 bh)) flags (cdr (assoc 70 bh)))
          (setq desc (gh:meta (cdr (assoc 4 bh)) plan maxn))
          ;; ★ 块头建不出来就【绝不往下灌】：block 与 ENDBLK 之间的那批 entmake
          ;;   一旦没有块上下文，会直接落进模型空间，变成几十个散图元 ——
          ;;   而且 entmake 只返回 nil、不报错，表面看"图没动"，其实图上多了
          ;;   一堆东西（2026-09-20 实测：newbn 不合法时整块内容漏进模型空间）。
          (setq hb (entmake (list '(0 . "BLOCK") '(100 . "AcDbEntity") '(8 . "0")
                                  '(100 . "AcDbBlockBegin")
                                  (cons 2 newbn) (cons 3 newbn)
                                  ;; 70 的 bit2 = 「含非常量属性定义」——少了它，
                                  ;; _. -INSERT 插这个定义出来一个属性都不带
                                  (cons 70 (logior (if flags flags 0) 2))
                                  (cons 10 base) (cons 4 (if desc desc "")))))
          (if (null hb)
            (progn
              (gkc:say (strcat SEP "  [" bn "] 新定义块头建不出来（newbn="
                              (if newbn newbn "nil") "），本块没动。"))
              nil)
            (progn
              (foreach ed (gkc:ents bn)
                (setq d2 ed d3 nil mid nil)
                ;; 单行「规格」跟着改名 -> 规格1（定义侧这一步不做，参照就配不上）
                (if (= "ATTDEF" (cdr (assoc 0 d2)))
                  (progn
                    (setq tg (cdr (assoc 2 d2)) n (gkc:slotno tg))
                    (if (and n (= (gkc:suffix tg) "规格") (cdr (assoc n da)))
                      (progn
                        (setq nt (gkc:mktag n "规格1"))
                        (foreach q d2
                          (setq d3 (cons (if (member (car q) '(2 3)) (cons (car q) nt) q) d3))
                        )
                        (setq d2 (reverse d3) tg nt)
                      )
                    )
                    ;; ★ 加高槽里【没分行的数据】（数量 / 名称 / 型号）垂直居中。
                    ;;   做法：保持它在原格里的相对位置不变 ——
                    ;;     ① 先按统一公式随槽下移（gh:sh，10/11 点一起动）；
                    ;;     ② 再额外下移本槽新增高度的一半（dy*P/2）。
                    ;;   原理：槽顶不动、槽底下移 dy*P，槽的垂直中点就下移 dy*P/2；
                    ;;   文字原来在格里怎么居中，就还怎么居中 —— 与对正方式
                    ;;   （基线 / 中间 / 顶）、字高 h 与行距 P 的比例都无关，
                    ;;   全程不用字高、也不用槽的上下边界线。
                    ;;   ★ 不能再用「新中点 - 半字高」现算目标 y，并把 10/11 都设成
                    ;;     同一个值：那只在【基线对正】时才对，且抹掉了 10/11 的关系。
                    ;;   ★ 规格类不居中：规格 1..N 本来就按行一格格往下排。
                    (if (and n (/= (substr (gkc:suffix tg) 1 4) "规格")
                             (cdr (assoc n da)))
                      (progn
                        (setq d2 (gh:sh d2 bots P da))
                        (setq d2 (gh:shdn d2 (/ (* P (cdr (assoc n da))) 2.0)))
                        (setq mid T)
                      )
                    )
                  )
                )
                (gkc:emit (if mid d2 (gh:sh d2 bots P da)))
              )
              (foreach ed addl (gkc:emit ed))
              (entmake '((0 . "ENDBLK") (100 . "AcDbEntity") (8 . "0") (100 . "AcDbBlockEnd")))
              (list newbn da)
            )
          )
        )
      )
    )
  )
)

;; ================================================================
;; 四、只读预演
;; ================================================================

;; 列一遍：哪些槽会加几行、块底再下移多少、块高新旧。
;;   全走只读调用（gkc:refs-from / gkc:rowfill / gkc:groups / gkc:geo /
;;   gkc:bb），图一个字节都不动。
(defun gh:dry (s plan / rf refs bad f1 addd rep gs g nb da bd B P maxn t2
                 mx e0 bb h0 h1)
  (if (null (gh:ensure))
    (strcat SEP "[GGH] 内核没就位：" gh:dep "（先 load 属性块-槽位增减.lsp）")
    (progn
      (setq rep "" )
      (setq rf (gkc:refs-from s) refs (car rf) bad (cadr rf))
      (setq f1 (gkc:rowfill refs) refs (car f1) addd (cadr f1))
      (cond
        ((null refs)
         (setq rep (strcat SEP "[GGH] 预演：没有有效参照（句柄无效或已删除）。")))
        (T
         (setq rep (strcat SEP "[GGH] 预演（图没动）"
                           (if addd
                             (strcat SEP "  按几何补齐整行：新纳入 " (itoa (length addd)) " 个")
                             "")))
         (setq gs (gkc:groups refs))
         ;; 与 gh:apply 同口径：表头沿用柜块的基准 da，不自己算
         (setq bd (gh:baseda gs plan))
         (foreach g gs
           (setq nb (car g)
                 da (if (car bd) (cadr bd) (gh:deltas nb plan)))
           (if da
             (progn
               (setq B (car (gkc:geo nb)) P (cadr (gkc:geo nb))
                     maxn (caddr (gkc:geo nb)) t2 (gh:sig da))
               ;; 块高新旧：拿本组首参照的包围盒量
               (setq e0 (cadr g) bb (gkc:bb e0) h0 nil h1 nil)
               (if bb
                 (progn
                   (setq h0 (- (cadr (cadr bb)) (cadr (car bb)))
                         h1 (+ h0 (* P t2)))))
               (setq rep (strcat rep SEP "  [" nb "] 加行 "
                                 (gkc:join
                                   (mapcar '(lambda (z) (strcat (itoa (car z)) "槽+"
                                                                (itoa (cdr z))))
                                           da) " ")
                                 "（共 " (itoa t2) " 行）"
                                 "；块底再下移 " (rtos (* P t2) 2 1)
                                 (if h0 (strcat "，块高 " (rtos h0 2 1)
                                                " -> " (rtos h1 2 1)) ""))))
             (setq rep (strcat rep SEP "  [" nb "] 不用动（行数与现状一致）")))
         )
        )
      )
      (if bad
        (setq rep (strcat rep SEP "  无效句柄：" (gkc:join bad ","))))
      rep
    )
  )
)

;; ================================================================
;; 五、主入口
;; ================================================================

;; 按行计划重建本排（给一个句柄也会按几何补齐整排）
;;   s    = 句柄串 / 句柄表
;;   plan = 每槽行数（表或 "1,3,1,2" 串；长度按最大槽号取，缺的按 1）
;;   返回 (报告 参照映射 定义映射) —— 与 gkc:expand 同形
(defun gh:apply (s plan / rf refs bad f1 addd frep rep mapped pairs gs g bd
                   nb r newbn res cnt oh nh da ok emsg)
  (if (null (gh:ensure))
    (list (strcat SEP "[GGH] 内核没就位：" gh:dep
                  "（先 load 属性块-槽位增减.lsp）") nil nil)
    (progn
      (setq rep "" mapped nil pairs nil frep "")
      (setq rf (gkc:refs-from s) refs (car rf) bad (cadr rf))
      (setq f1 (gkc:rowfill refs) refs (car f1) addd (cadr f1))
      (if addd
        (setq frep (strcat "[GGH] 按几何补齐整行：新纳入 " (itoa (length addd)) " 个；"))
      )
      (cond
        ((null refs)
         (setq rep "[GGH] 没有有效参照（句柄无效或已删除），图没动。"))
        (T
         (setq gs (gkc:groups refs))
         ;; 整排基准 da：拿柜块算，表头照它执行（见 gh:baseda）
         (setq bd (gh:baseda gs plan))
         ;; 新定义名一次算完 —— 等第一组建好再算，gkc:newname 会给带 (1) 的名字
         (foreach g gs
           (setq pairs (cons (cons (car g) (gkc:newname (car g) (cadr g))) pairs))
         )
         (setq pairs (reverse pairs))
         (foreach g gs
           (setq nb (car g) r (cdr g) newbn (cdr (assoc nb pairs)))
           ;; 每组单独兜住 —— 一组炸了不许把后面的组和回包一起吞掉
           (setq res (vl-catch-all-apply 'gh:rebuild
                                         (list nb newbn plan
                                               (if (car bd) (cadr bd) 'AUTO))))
           (cond
             ((vl-catch-all-error-p res)
              (setq rep (strcat rep SEP "  [" nb "] 重建报错，本组跳过："
                                (vl-catch-all-error-message res))))
             ((null res)
              (setq rep (strcat rep SEP "  [" nb "] 没动（行数与现状一致，或块头没建出来）")))
             (T
              (setq da (cadr res))
              ;; 先改参照标签 -> newref 按 tag 迁值才匹配得上
              (foreach x r (gh:relabel x da "规格" "规格1"))
              (setq cnt 0 ok 0 emsg "")
              (foreach x r
                (setq oh (cdr (assoc 5 (entget x))))
                (setq nh (vl-catch-all-apply 'gkc:newref (list x (car res) nil)))
                (cond
                  ((vl-catch-all-error-p nh)
                   (gh:relabel x da "规格1" "规格")
                   (setq ok (1+ ok))
                   (if (= emsg "") (setq emsg (vl-catch-all-error-message nh))))
                  ((null nh)
                   ;; 重造失败 -> 标签改回去，别把旧参照弄成孤儿属性
                   (gh:relabel x da "规格1" "规格")
                   (setq ok (1+ ok)))
                  (T
                   (setq cnt (1+ cnt))
                   (setq mapped (cons (list oh nh (car res)) mapped)))
                )
              )
              (setq rep (strcat rep SEP "  [" nb "] 加行 "
                                (gkc:join
                                  (mapcar '(lambda (z) (strcat (itoa (car z)) "槽+"
                                                               (itoa (cdr z))))
                                          (reverse da)) " ")
                                "；新定义 " (car res)
                                "；同步 " (itoa cnt) " 个参照（重造，句柄已变）"
                                (if (> ok 0) (strcat "；" (itoa ok)
                                                     " 个重造失败已回滚"
                                                     (if (= emsg "") ""
                                                       (strcat "（" emsg "）")))
                                  "")))
             )
           )
         )
        )
      )
      (gkc:say rep)
      ;; (报告 参照映射 定义映射)
      (list (strcat "[GGH-RESULT]" frep rep
                    "|@defs=" (if pairs
                                (apply 'strcat
                                       (mapcar '(lambda (z)
                                                  (strcat (car z) ">" (cdr z) ";"))
                                               pairs))
                                "")
                    "|@refs=" (if mapped
                                (apply 'strcat
                                       (mapcar '(lambda (z)
                                                  (strcat (car z) ">" (cadr z) ">"
                                                          (caddr z) ";"))
                                               mapped))
                                "")
                    "|@bad=" (if bad (gkc:join bad ",") ""))
            (reverse mapped) (reverse pairs))
    )
  )
)

;; 单槽：只让第 n 槽到 rows 行（其余槽保持现状）
;;   gh:rebuild 只处理「目标行数 > 现状」的槽，所以 plan 里其余位填 1
;;   不会把已经加高的槽缩回去。
;;   ★ 每调一次句柄全变；要改多个槽就自己拼好 plan 一次调 gh:apply。
(defun gh:slot (s n rows / rf refs mx i bn pl)
  (if (null (gh:ensure))
    (list (strcat SEP "[GGH] 内核没就位：" gh:dep) nil nil)
    (progn
      (setq rf (gkc:refs-from s) refs (car rf))
      (if (null refs)
        (list (strcat SEP "[GGH] 没有有效参照，图没动。") nil nil)
        (progn
          (setq refs (car (gkc:rowfill refs)))
          (setq mx 0)
          (foreach e refs
            (setq bn (cdr (assoc 2 (entget e))))
            (setq i (gkc:maxslot bn))
            (if (and i (> i mx)) (setq mx i))
          )
          (setq pl nil i 1)
          (while (<= i mx)
            (setq pl (cons (if (= i n) rows 1) pl))
            (setq i (1+ i))
          )
          (gh:apply s (reverse pl))
        )
      )
    )
  )
)

;; ================================================================
;; 六、命令外壳
;; ================================================================

;; 点一个块 -> 问每槽行数 -> 重建
(defun c:GGH ( / e s pl r)
  (if (null (gh:ensure))
    (princ (strcat SEP "内核没就位：" gh:dep))
    (progn
      (setq e (car (entsel (strcat SEP "选本排任一槽位属性块: "))))
      (if (null e)
        (princ (strcat SEP "没选，退出。"))
        (progn
          (setq s (cdr (assoc 5 (entget e))))
          (setq pl (getstring T (strcat SEP
                                        "每槽行数（逗号分隔，如 1,1,1,1,1,3,1；回车=全 1）: ")))
          (setq r (gh:apply s pl))
          (princ (strcat SEP (car r)))
        )
      )
    )
  )
  (princ)
)

(princ)


;;; ================================================================
;;; 模块 三、属性块-箱变.lsp（XBT，命令 XBT）
;;; ================================================================

;;; ============================================================
;;; 属性块-箱变.lsp                                    命令：XBT
;;; ------------------------------------------------------------
;;; 作用
;;;   箱变（高压段 + 低压段）两段独立表的【铺图】：
;;;   头尾各一枚表头块，中间按清单顺序排柜块 —— 全程只【调用】现成块，
;;;   不生成新块型、不做 MCP 那套参数计算：
;;;       [高压表头] [G1] [BYQ] [D1] [D2] [低压表头]
;;;                  40宽        35   35   35   35      40宽
;;;   两段的区别只写在【属性值】里（铜排规格 / 电压等级不同），
;;;   块型是同一份 —— 所以两段天然等高，不需要配平（MCP 才要）。
;;;
;;;   【分段口径】清单里写几条「表头」行就是几段（表头行切段）：
;;;     表头 | TMY-50*5 | 10kV             <- 段 1（图上最左那枚）
;;;     @G1 … @BYQ …                      <- 属段 1
;;;     表头 | TMY-100*8 N80*8 | 0.4kV    <- 段 2（图上最右那枚）
;;;     @D1 … @D2 …                       <- 属段 2
;;;     · 两段【各自从第 1 槽起】编号（同一槽号在两段是不同元件）
;;;     · 槽数 = max(高压段, 低压段) —— 块定义共用，只能取两段较大者
;;;     · 表头【各写各段】：第 j 枚表头只写第 j 段的元件
;;;     · 行高计划逐槽取两段最大（同上，块定义共用）
;;;   只写 1 条表头行 -> 1 段 -> 与 KYN28 单段完全同路。
;;;
;;;   铺完调一次 GGH（gh:apply）按数据统一加行高：长规格的槽位在
;;;   同一槽里向下长行，标签变成 元件NN规格1..M（不拆到别的槽位）。
;;;   加行高【全排统一】—— 块定义是共用的，加一处就是全排。
;;;
;;;   高度不用量 —— 块高只由【总行数】定：
;;;     总行数 = 每槽行数之和 = 槽数 + 加行数
;;;     块高   = 基础高(未加行时) + 行距P × (总行数 - 槽数)
;;;            = 124 + 6 × 总行数        （本块族：15槽基础高214 / 14槽208）
;;;   表头每槽恒 1 行，对表头就是「总行数 = 槽数」——
;;;   即你说的「表头高度由槽数定义」。柜块与表头同一份行高计划
;;;   -> 同一个总行数 -> 同一个块高 -> 两段天然等高，不用配平。
;;;
;;; 清单格式：与 PLT 完全同源（同一份 txt，两个命令一起吃）
;;;     表头 | TMY-50*5 | 10kV                  <- 第 1 枚表头（最左）
;;;     @G1 | 高压进出线柜 | | | 630KVA | |
;;;     1 | 负荷开关 | FN12-12RD | 125A 31.5kA 手动电分 | 1
;;;     @BYQ | 变压器 | | | 1000KVA | |
;;;     1 | 变压器 | S13 | 1000KVA 10+/-2*2.5%/0.4kV ud%＝4 Dyn11 | 1
;;;     表头 | TMY-100*8 N80*8 PE50*5 | 0.4kV    <- 第 2 枚表头（最右）
;;;     @D1 | 低压进出线柜 | | | | |
;;;     @D2 | 电容柜 | | | | |
;;;   表头行【写在它那一段的柜之前】：表头行之后、下一条表头行之前的柜
;;;   都属这一段。表头行出现顺序 = 图上表头从左到右的顺序；
;;;   柜头行出现顺序 = 图上柜从左到右的顺序。
;;;
;;; 入口
;;;   (xbt:run "清单文本")        真铺
;;;   (xbt:dry "清单文本")        只算不铺
;;;   (xbt:runfile "清单.txt")    从 GBK 文件读
;;;   (xbt:dryfile "清单.txt")    只算不铺
;;;   命令 XBT —— 交互，问清单文件路径
;;;
;;; 依赖（都自动 load）
;;;   属性块-铺图.lsp      pgt:* 模板导入 / 插块 / 量几何 / 定槽
;;;   属性块-槽位增减.lsp  gkc:* 定槽（增减槽位）
;;;   属性块-增加行高.lsp  gh:*  加行高（gh:apply）
;;;   属性块-批量填数.lsp  plt:parse / plt:plan / plt:wrap（口径同源）
;;;   模板 dwg：图框模版 / 柜块模版 / 表头块模版 / 占位块
;;;
;;; 边界
;;;   1 一框一排：整排宽 表头40 + N*柜35 + 表头40，加左边距 35 超过框宽
;;;     420 就拒绝并报差多少（箱变一般 4~8 台，够用）
;;;   2 占位块在【加行高之后】才插 —— gh:apply 会按几何补齐整排，
;;;     占位块不是槽位块，先插进去会被卷进分组空转一轮
;;;   3 不存盘 —— 落不落盘你自己定
;;;
;;; 编码：ANSI/GBK 无 BOM
;;; ============================================================
(vl-load-com)
(if (not (boundp 'SEP)) (setq SEP (chr 10)))

(setq *xbt:padl*   35.0)   ; 表头几何左离框左（与 PGT 同口径）
(setq *xbt:padt*   14.0)   ; 柜块几何顶离框顶
(setq *xbt:phgap*   3.0)   ; 占位块几何顶离柜块几何顶
(setq *xbt:rowsmax*   9)   ; 单槽最多几行（与 MCP SLOT_FIELD_ROWS_MAX 同口径）

;; ================================================================
;; 一、依赖与小工具
;; ================================================================

;; 按名找 lsp 并 load；成 T
(defun xbt:ld (n / f p)
  (setq f (findfile (strcat n ".lsp")))
  (if (null f) (setq f (findfile (strcat "D:/kk三部曲/148.CAD插件研究/lisp/" n ".lsp"))))
  (if f
    (progn (setq p (vl-catch-all-apply 'load (list f)))
           (not (vl-catch-all-error-p p)))
    nil)
)

(defun xbt:ensure ()
  (if (not (member 'PGT:INS (atoms-family 0)))    (xbt:ld "属性块-铺图"))
  (if (not (member 'GKC:REBUILD (atoms-family 0))) (xbt:ld "属性块-槽位增减"))
  (if (not (member 'GH:APPLY (atoms-family 0)))   (xbt:ld "属性块-增加行高"))
  (if (not (member 'PLT:PLAN (atoms-family 0)))   (xbt:ld "属性块-批量填数"))
  (and (member 'PGT:INS (atoms-family 0))
       (member 'GH:APPLY (atoms-family 0))
       (member 'PLT:PLAN (atoms-family 0)))
)

;; VLA 块参照 -> 句柄（拿不到返回 nil）
(defun xbt:hd (o / r)
  (if o
    (progn
      (setq r (vl-catch-all-apply 'vlax-vla-object->ename (list o)))
      (if (vl-catch-all-error-p r) nil (cdr (assoc 5 (entget r))))
    )
    nil)
)

;; 模型空间里【块名在 names 里】的参照句柄，按插入点 x 从左到右
;;   只认柜块 / 表头块，不认 占位块、不认图框（图框是炸开的散图元）
(defun xbt:refhd (names / ss i n e bn x out)
  (setq out nil)
  (setq ss (ssget "_X" '((0 . "INSERT") (410 . "Model"))))
  (if ss
    (progn
      (setq i 0 n (sslength ss))
      (while (< i n)
        (setq e (ssname ss i))
        (setq bn (cdr (assoc 2 (entget e))))
        (if (member bn names)
          (progn
            (setq x (car (cdr (assoc 10 (entget e)))))
            (setq out (cons (cons x (cdr (assoc 5 (entget e)))) out))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (plt:hsort out)
)

;; ================================================================
;; 二、行高计划
;; ================================================================

;; 按清单算每槽需要的行数 -> "M1,M2,..."（逗号串，直接喂 gh:apply）
;;   口径（与 MCP _cabinet_slot_rows 一致）：
;;     · 空规格恒算 1 行
;;     · 有规格按【显示宽度】拆行取行数
;;     · 同一槽取【全排最大】—— 块定义是共用的，只能取最大；
;;       箱变两段独立编号时它自动等于「逐槽取两段最大」
;;     · 单槽封顶 *xbt:rowsmax* 行
(defun xbt:rowplan (cabs map pls need / pl k mx rw emv)
  (setq pl "")
  (foreach k (plt:seq 1 need)
    (setq mx 1)
    (foreach cab cabs
      (setq emv (assoc k (plt:cabget cab map pls)))
      (if emv
        (progn
          (setq rw (length (plt:wrap (nth 3 (cdr emv)) *plt:slot-col*)))
          (if (> rw mx) (setq mx rw))
        )
      )
    )
    (if (> mx *xbt:rowsmax*) (setq mx *xbt:rowsmax*))
    (setq pl (strcat pl (if (= pl "") "" ",") (itoa mx)))
  )
  pl
)

;; 计划里有没有 >1 的槽（全 1 就不必调 GGH）
(defun xbt:needrows (pl / r v)
  (setq r nil)
  (foreach v (gkc:tokens pl)
    (if (> (atoi v) 1) (setq r T))
  )
  r
)

;; 计划里的【总行数】（每槽行数之和）—— 块高就由它定
(defun xbt:rows (pl / s v)
  (setq s 0)
  (foreach v (gkc:tokens pl)
    (setq s (+ s (atoi v)))
  )
  s
)

;; 铺图前清掉【上一轮留下的、未被引用的】克隆定义
;;   gkc:newname 碰到重名会无脑加 (1)(2)(3)… —— 反复铺图就攒一堆
;;   柜块模版-排(1)(2)…。先把未引用的清掉，名字腾空，
;;   gkc:newname 每次就能拿到干净的 柜块模版-排 / 表头块模版-表头。
;;   被引用的定义会被 -PURGE 自己拒绝 —— 所以不会碰已铺好的图。
;;   返回清掉几个。
(defun xbt:purgeold ( / b nm lst k ce)
  (setq b (tblnext "BLOCK" T) lst nil)
  (while b
    (setq nm (cdr (assoc 2 b)))
    (if (and (/= nm "") (wcmatch nm "柜块模版-排*,表头块模版-表头*"))
      (setq lst (cons nm lst))
    )
    (setq b (tblnext "BLOCK"))
  )
  (setq k 0 ce (getvar "CMDECHO"))
  (setvar "CMDECHO" 0)
  (foreach nm lst
    (if (tblobjname "BLOCK" nm)
      (progn
        (command "_.-PURGE" "_B" nm "_N")
        (if (null (tblobjname "BLOCK" nm)) (setq k (1+ k)))
      )
    )
  )
  (setvar "CMDECHO" ce)
  k
)

;; ================================================================
;; 三、主流程
;; ================================================================
(defun xbt:go (tx write / ps bus vol cabs warns tb hdrs rpt
                          need pl map pls nseg segtxt ex sx dfs cabn hdrn n
                          fa ar cr hr pr fw fh hw cw crx cry hrx hry phx phy
                          ftop caby hdry phyy bx by hdrx2 i
                          h1 h2 cabx0 totw hs plan rp rl
                          cntf cnth cntc cntp hd rsum bh pit gx cpur sd)
  (if (null (xbt:ensure))
    (strcat "缺依赖（属性块-铺图 / 属性块-槽位增减 / 属性块-增加行高 / 属性块-批量填数 有一个 load 不上），"
            "没动图。")
    (progn
      (setq ps (plt:parse tx))
      (setq bus (car ps) vol (cadr ps) cabs (caddr ps)
            warns (cadddr ps) tb (nth 4 ps) hdrs (nth 5 ps) sd (nth 6 ps))
      (cond
        ((null cabs)
         (strcat "清单里没解析出柜头行（柜头行必须以 @ 开头），没动图。" SEP
                 (if warns (strcat "  " (car warns) SEP) "")))
        ((and write (null (pgt:ms)))
         "拿不到模型空间（COM 没通），没动图。")
        (T
         ;; --- 四个块定义带进本图（只加定义，不加图元）---
         (pgt:import "图框模版.dwg" "图框模版")
         (pgt:import "柜块模版.dwg" "柜块模版")
         (pgt:import "表头块模版.dwg" "表头块模版")
         (pgt:import "占位块.dwg" "占位块")
         (cond
           ((or (null (pgt:defp "图框模版")) (null (pgt:defp "柜块模版"))
                (null (pgt:defp "表头块模版")) (null (pgt:defp "占位块")))
            "四个块定义没全进到本图（模板插不进来？），没动图。")
           (T
            ;; --- 先把上轮未引用的克隆定义清掉，腾出干净名字 ---
            (setq cpur (xbt:purgeold))
            ;; --- 排槽（与 PLT 完全同一套口径）---
            ;;   清单写了几条表头行就是几段：
            ;;     1 条 -> 1 段，老路 plt:plan
            ;;     2 条 -> 2 段，各段【独立从第 1 槽起】编号，
            ;;             槽数 = max(高压段, 低压段)（块定义共用，只能取大）
            (setq nseg (length (plt:segs cabs)))
            (if (> nseg 1)
              (progn
                (setq pls (plt:planseg cabs sd) map nil need (plt:needseg pls))
              )
              (progn
                (setq pl (plt:plan cabs (plt:sdef-at sd 1))
                      map (car pl) need (cadr pl) pls nil)
              )
            )
            ;; 段摘要：段 1（槽 6） / 段 2（槽 8）
            (setq segtxt "")
            (if pls
              (foreach ex pls
                (setq segtxt (strcat segtxt (if (= segtxt "") "" "，")
                                     "段 " (itoa (car ex))
                                     "（槽 " (itoa (caddr ex)) "）"))
              )
            )
            ;; 防呆：清单写了多遍表头行却没切出第 2 段 —— 旧写法（表头行在末尾）
            (if (and hdrs (> (length hdrs) 1) (= nseg 1))
              (setq warns (append warns
                                  (list (strcat "清单写了 " (itoa (length hdrs))
                                                " 条表头行，却只切出 1 段 —— "
                                                "表头行要写在它那一段的柜之前"))))
            )
            ;; --- 定槽：按数据算出的槽数去要现成块（不等于模板槽数才克隆一次）---
            (setq dfs (pgt:defs need "柜块模版" "表头块模版"))
            (setq cabn (car dfs) hdrn (cadr dfs) n (caddr dfs))
            ;; --- 量几何 ---
            (setq fa (pgt:fanchor))
            (setq ar (if fa (pgt:rng (car fa))))
            (setq cr (pgt:rng cabn) hr (pgt:rng hdrn) pr (pgt:rng "占位块"))
            (cond
              ((null fa)
               "图框模版里找不到锚块（那个 * 开头的匿名块参照），没动图。")
              ((or (null ar) (null cr) (null hr) (null pr))
               "量不到块定义几何（图框 / 柜块 / 表头 / 占位块 有一个缺），没动图。")
              (T
               (setq fw (- (nth 2 ar) (car ar)) fh (- (nth 3 ar) (nth 1 ar)))
               (setq hw (- (nth 2 hr) (car hr)))     ; 表头块宽 40
               (setq cw (- (nth 2 cr) (car cr)))     ; 柜块宽 35
               (setq crx (car cr) cry (nth 3 cr))    ; 柜块几何 左 / 顶
               (setq hrx (car hr) hry (nth 3 hr))    ; 表头几何 左 / 顶
               (setq phx (car pr) phy (nth 3 pr))    ; 占位块几何 左 / 顶
               (setq totw (+ hw (* (length cabs) cw) hw))   ; 表头 + 柜 + 表头
               (setq bx 0.0 by 0.0)
               (setq hdrx2 (- (+ bx *xbt:padl* totw) hw))   ; 尾表头几何左
               (cond
                 ((> (+ *xbt:padl* totw) fw)
                  (strcat "装不下：整排宽 " (rtos totw 2 1)
                          " + 左边距 " (rtos *xbt:padl* 2 1)
                          " = " (rtos (+ *xbt:padl* totw) 2 1)
                          "，超过框宽 " (rtos fw 2 0) " 共 "
                          (rtos (- (+ *xbt:padl* totw) fw) 2 1)
                          " —— 柜少一点或柜块窄一点，没动图。"))
                 (T
                  ;; 与第几台无关的 y，一次算完
                  (setq ftop (+ by fh))
                  (setq caby (- ftop *xbt:padt* cry))
                  (setq hdry (- ftop *xbt:padt* hry))
                  (setq phyy (- ftop *xbt:padt* *xbt:phgap* phy))
                  ;; 行高计划：写不写都要用它出报告
                  (setq plan (xbt:rowplan cabs map pls need))
                  ;; 高度是算出来的，不是量出来的：
                  ;;   基础高 = 加行高之前量的 cr（此时块还是模板槽数 n）
                  ;;   行距P  = gkc:geo 第 2 项（本块族 6.0）
                  ;;   块高   = 基础高 + P × (总行数 - n)
                  (setq rsum (xbt:rows plan))
                  (setq gx (vl-catch-all-apply 'gkc:geo (list cabn)))
                  (if (vl-catch-all-error-p gx) (setq gx nil))
                  (setq pit (if (and gx (numberp (cadr gx))) (cadr gx) 6.0))
                  (setq bh (+ (- (nth 3 cr) (nth 1 cr)) (* pit (- rsum n))))
                  ;; 垂直余量：块只向下长，顶距固定 —— 算得到底距，不用量
                  (if (< (- fh *xbt:padt* bh) 0.0)
                    (setq warns
                          (append warns
                                  (list (strcat "块高压穿框底：块高 " (rtos bh 2 1)
                                                " + 顶距 " (rtos *xbt:padt* 2 0)
                                                " = " (rtos (+ bh *xbt:padt*) 2 1)
                                                " > 框高 " (rtos fh 2 0))))))
                  (setq cntf 0 cnth 0 cntc 0 cntp 0 h1 nil h2 nil rp nil)
                  (if write
                    (progn
                      ;; ① 图框（COM 插 + COM 炸开，框左下角在定义内要反向补偿）
                      (setq i (pgt:ins "图框模版"
                                       (list (- bx (cadr fa) (car ar))
                                             (- by (caddr fa) (nth 1 ar)))))
                      (if i (progn (setq cntf (1+ cntf)) (pgt:exp i)))
                      ;; ② 第 1 枚表头（最左 = 高压段）
                      (setq h1 (pgt:ins hdrn (list (- (+ bx *xbt:padl*) hrx) hdry)))
                      (if h1 (setq cnth (1+ cnth)))
                      ;; ③ 中间柜，按清单顺序往右排，只写柜号
                      (setq i 0)
                      (foreach cab cabs
                        (setq cabx0 (+ bx *xbt:padl* hw (* i cw)))
                        (setq hd (pgt:ins cabn (list (- cabx0 crx) caby)))
                        (if hd
                          (progn
                            (setq cntc (1+ cntc))
                            (pgt:setatt hd "柜号" (nth 0 cab))
                          )
                        )
                        (setq i (1+ i))
                      )
                      ;; ④ 第 2 枚表头（最右 = 低压段）—— 放在所有柜之后
                      (setq h2 (pgt:ins hdrn (list (- hdrx2 hrx) hdry)))
                      (if h2 (setq cnth (1+ cnth)))
                      ;; ⑤ 加行高：全排统一（块定义共用，加一处就是全排）。
                      ;;    句柄在【改名之前】按 x 从左到右取 —— 之后块名就变了。
                      ;;    gh:apply 自己会按几何补齐整排，这里给全排更清楚。
                      ;;    整段兜住：加行高出问题不该把已经铺好的图连报告一起吞掉
                      (if (xbt:needrows plan)
                        (progn
                          (setq hs "")
                          (setq rl (xbt:refhd (list cabn hdrn)))
                          (foreach hd rl
                            (setq hs (strcat hs (if (= hs "") "" ",") hd))
                          )
                          (setq rp (vl-catch-all-apply 'gh:apply (list hs plan)))
                          (if (vl-catch-all-error-p rp)
                            (setq rp (list (strcat "加行高失败（图已铺好，可单独敲 GGH 补）："
                                                   (vl-catch-all-error-message rp))))
                          )
                        )
                      )
                      ;; ⑥ 占位块 —— 放在加行高【之后】：它不是槽位块，
                      ;;    先插会被 gh:apply 的「按几何补齐整排」卷进分组空转。
                      ;;    柜块只是向下长高，几何顶没动 -> 占位块 y 依旧成立。
                      (setq i 0)
                      (foreach cab cabs
                        (setq cabx0 (+ bx *xbt:padl* hw (* i cw)))
                        (if (pgt:ins "占位块" (list (- cabx0 phx) phyy))
                          (setq cntp (1+ cntp))
                        )
                        (setq i (1+ i))
                      )
                    )
                  )
                  ;; --- 报告：只给读回结论（数量 / 落点 / 行高 / warnings）---
                  (setq rpt
                    (strcat
                      (if write "已铺" "【只算没铺】")
                      "：箱变 " (itoa (length cabs)) " 台柜"
                      " / 槽位 " (itoa n) "（清单需 " (itoa need) "）"
                      " / 表头 2 枚（清单给了 " (itoa (length hdrs)) " 遍）" SEP
                      (if pls
                        (strcat "  分段 " (itoa nseg) "（各段独立从第 1 槽起）："
                                segtxt SEP)
                        "")
                      (if (and pls (> (length hdrs) nseg))
                        (strcat "  提示：清单只切出 " (itoa nseg)
                                " 段，清单里的表头行数与段数不一致" SEP)
                        "")
                      "  柜型定义：" cabn "，表头定义：" hdrn SEP
                      "  整排宽 " (rtos totw 2 1)
                      "（表头 " (rtos hw 2 0) " + 柜 " (itoa (length cabs))
                      "×" (rtos cw 2 0) " + 表头 " (rtos hw 2 0) "）"
                      "，框宽 " (rtos fw 2 0) SEP
                      "  落点：前表头几何左 " (rtos (+ bx *xbt:padl*) 2 1)
                      "，第 1 台柜几何左 " (rtos (+ bx *xbt:padl* hw) 2 1)
                      "，尾表头几何左 " (rtos hdrx2 2 1) SEP
                      "  清旧克隆：" (itoa cpur) " 个" SEP
                      "  行高计划：" plan
                      (if (xbt:needrows plan)
                        "  -> 已调 GGH 全排加行高"
                        "  -> 全 1 行，没调 GGH") SEP
                      "  高度：总行数 " (itoa rsum)
                      "（槽 " (itoa n) " + 加行 " (itoa (- rsum n))
                      "）× 行距 " (rtos pit 2 1)
                      " -> 块高 " (rtos bh 2 1) SEP
                      "        框高 " (rtos fh 2 0)
                      "，顶距 " (rtos *xbt:padt* 2 0)
                      "，底距 " (rtos (- fh *xbt:padt* bh) 2 1) SEP
                      (if write
                        (strcat "  实插：图框 " (itoa cntf)
                                "，表头 " (itoa cnth) "/2"
                                "，柜块 " (itoa cntc) "/" (itoa (length cabs))
                                "，占位块 " (itoa cntp) "/" (itoa (length cabs)) SEP)
                        (strcat "  只算没铺：一个字没写。" SEP))
                      (if rp (strcat "  GGH：" (car rp) SEP) "")
                      (if warns
                        (strcat "  警告 " (itoa (length warns)) " 条：" SEP
                                (apply 'strcat
                                       (mapcar '(lambda (x) (strcat "    " x SEP)) warns)))
                        "")
                      (if write "  没存盘，改动都在内存里。" "")
                    )
                  )
                  rpt
                 )
               )
              )
             )
            )
           )
          )
         )
        )
      )
    )

