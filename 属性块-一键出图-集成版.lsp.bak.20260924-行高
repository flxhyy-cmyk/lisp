;; ================================================================
;; 七、剪贴板读取与交互界面（粘贴一键出图）
;; ================================================================
;; DCL 原生控件没有"可粘贴的多行文本框"，所以交互入口的"粘贴"采用
;; CAD 插件里最常见的做法：配套的「箱变生成器」「KYN28 生成器」网页点一下
;; 「写回」按钮，会把整理好的清单文本自动复制到 Windows 剪贴板；回到本
;; 对话框点按钮，程序直接从剪贴板取文本 —— 对用户来说仍然是"点一下写回、
;; 再点一下出图"，只是"粘贴"动作发生在点按钮那一刻，而不是敲进某个输入框。
;; 本机同样接受不经那两个网页、手工按同一格式整理好后复制来的文本。
;; 对话框本身（DCL）在运行时生成到系统临时目录，用完即删 —— 不需要
;; 随本文件再带一份 .dcl，整套工具仍然只有【一个】.lsp 文件。

;; 读取剪贴板文本 —— 两级方案，任何一级拿到非空文本即返回：
;;   ① PowerShell + System.Windows.Forms.Clipboard（首选，最稳）
;;      旧版只走 htmlfile.parentWindow.clipboardData，那条路依赖 IE 的
;;      "允许通过脚本访问剪贴板"安全设置：Win10/11 上要么弹确认框、要么
;;      直接返回空/报错（新版 CAD 的 COM 环境里尤其常见），所以不能单靠它。
;;      这里让 PowerShell 隐藏运行，把剪贴板文本以 UTF-8 写到临时文件，
;;      再用 czt:rd1（ADODB）读回来 —— 中文不会乱码，也不弹任何窗口。
;;   ② htmlfile（原方案，留作兜底：没有 PowerShell 的老系统可用）
;; 读不到 / 剪贴板不是文本 / 剪贴板是空的 -> 返回 nil。

(defun czt:clip-ps ( / sh tmp cmd txt)
  (setq tmp (vl-string-translate "/" "\\" (vl-filename-mktemp "czt_clip" nil ".txt")))
  (if (findfile tmp) (vl-file-delete tmp))
  (setq sh (vl-catch-all-apply 'vlax-create-object (list "WScript.Shell")))
  (if (vl-catch-all-error-p sh)
    nil
    (progn
      (setq cmd
        (strcat
          "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -Command \""
          "Add-Type -AssemblyName System.Windows.Forms; "
          "$t=[System.Windows.Forms.Clipboard]::GetText([System.Windows.Forms.TextDataFormat]::UnicodeText); "
          "[System.IO.File]::WriteAllText('" tmp "',$t,(New-Object System.Text.UTF8Encoding($true)))"
          "\""))
      ;; 0 = 隐藏窗口；:vlax-true = 等它跑完再往下
      (vl-catch-all-apply 'vlax-invoke-method (list sh 'Run cmd 0 :vlax-true))
      (vl-catch-all-apply 'vlax-release-object (list sh))
      (setq txt (if (findfile tmp) (czt:rd1 tmp "utf-8") nil))
      (if (findfile tmp) (vl-file-delete tmp))
      (if (and (= (type txt) 'STR) (/= txt "")) txt nil)
    )
  )
)

(defun czt:clip-html ( / htm win cbd txt)
  (setq htm (vl-catch-all-apply 'vlax-get-or-create-object (list "htmlfile")))
  (if (vl-catch-all-error-p htm)
    nil
    (progn
      (setq win (vl-catch-all-apply 'vlax-get-property (list htm 'parentwindow)))
      (setq cbd (if (vl-catch-all-error-p win)
                  nil
                  (vl-catch-all-apply 'vlax-get-property (list win 'clipboarddata))
                ))
      (setq txt (if (or (null cbd) (vl-catch-all-error-p cbd))
                  nil
                  (vl-catch-all-apply 'vlax-invoke-method (list cbd 'getdata "Text"))
                ))
      (vl-catch-all-apply 'vlax-release-object (list htm))
      (if (or (null txt) (vl-catch-all-error-p txt) (/= (type txt) 'STR) (= txt ""))
        nil
        txt
      )
    )
  )
)

(defun czt:clip ( / tx)
  (setq tx (czt:clip-ps))
  (if (null tx) (setq tx (czt:clip-html)))
  tx
)

;; ----------------------------------------------------------------
;; 反向：文本 -> 剪贴板（与 czt:clip-ps 对称的第二套通道）
;;   文本先用 ADODB 按 utf-8 落到临时文件，再让 PowerShell 读回并
;;   Clipboard::SetText —— 绕这一圈是因为清单里含 | @ # 换行和中文，
;;   直接拼进 powershell -Command 的命令行会被引号/转义吃掉，必变形。
;;   为什么敢在对话框回调里跑：读剪贴板走的就是同一条
;;   WScript.Shell 同步 Run，实测在 DCL 打开状态下正常返回、不卡死；
;;   这条只是把 GetText 换成 SetText，同样不碰 CAD 命令行。
;; ----------------------------------------------------------------

;; 按 utf-8 写文本文件（COM 不可用 / 写失败返回 nil）
(defun czt:wr1 (tx f / s r)
  (if (findfile f) (vl-file-delete f))
  (setq s (vl-catch-all-apply 'vlax-create-object (list "ADODB.Stream")))
  (if (vl-catch-all-error-p s)
    nil
    (progn
      (vl-catch-all-apply 'vlax-put (list s 'Type 2))
      (vl-catch-all-apply 'vlax-put (list s 'Charset "utf-8"))
      (vl-catch-all-apply 'vlax-invoke (list s 'Open))
      (vl-catch-all-apply 'vlax-invoke (list s 'WriteText tx))
      ;; 2 = adSaveCreateOverWrite
      (setq r (vl-catch-all-apply 'vlax-invoke (list s 'SaveToFile f 2)))
      (vl-catch-all-apply 'vlax-invoke (list s 'Close))
      (if (and (not (vl-catch-all-error-p r)) (findfile f)) T nil)
    )
  )
)

;; 文本 -> 剪贴板（成功 T）。空文本直接拒。
(defun czt:clip-set (tx / tmp ok sh cmd rc)
  (setq tx (czt:flat tx))
  (if (= tx "")
    nil
    (progn
      (setq tmp (vl-string-translate "/" "\\" (vl-filename-mktemp "czt_pb" nil ".txt")))
      (setq ok (czt:wr1 tx tmp))
      (if ok
        (progn
          (setq sh (vl-catch-all-apply 'vlax-create-object (list "WScript.Shell")))
          (if (vl-catch-all-error-p sh)
            (setq ok nil)
            (progn
              (setq cmd
                (strcat
                  "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -Command \""
                  "Add-Type -AssemblyName System.Windows.Forms; "
                  "$t=[System.IO.File]::ReadAllText('" tmp "',[System.Text.Encoding]::UTF8); "
                  "[System.Windows.Forms.Clipboard]::SetText($t,[System.Windows.Forms.TextDataFormat]::UnicodeText); "
                  "[System.IO.File]::WriteAllText('" tmp ".ok','ok')"
                  "\""))
              ;; 0 = 隐藏窗口；:vlax-true = 等它跑完
              (setq rc (vl-catch-all-apply 'vlax-invoke-method (list sh 'Run cmd 0 :vlax-true)))
              (vl-catch-all-apply 'vlax-release-object (list sh))
              (setq ok (and (not (vl-catch-all-error-p rc))
                            (= (type rc) (quote INT))
                            (= rc 0)))
              ;; 退出码拿不到时，看 PowerShell 末尾写的哨兵
              (if (null ok) (setq ok (if (findfile (strcat tmp ".ok")) T nil)))
              (if (findfile (strcat tmp ".ok")) (vl-file-delete (strcat tmp ".ok")))
            )
          )
        )
      )
      (if (findfile tmp) (vl-file-delete tmp))
      ok
    )
  )
)

;; ================================================================
;; 反向导出：当前图纸 -> 清单文本（纯只读，不动图）
;;   扫模型空间的**属性块**（柜块 / 表头块）与图签 TEXT，按 CZT 支持的
;;   清单格式原样拼回来 —— 与「粘贴剪贴板清单 -> 出图」正好反向。
;;   产物直接喂 CZT / PLT 能跑，粘回网页生成器也能再编辑。
;;
;;   口径（与正向对称，不认块名、只认标签）：
;;     · 柜块   = 带「柜号」标签的 INSERT
;;     · 表头块 = 带「主母线规格」标签的 INSERT
;;     · 柜级 6 项     读柜块：柜用途 / 柜型 / 柜尺寸 / 容量功率 / 分支电流 / 备注
;;     · 元件名称/型号  读**表头块**槽位（元件NN名称 / 元件NN型号）
;;     · 元件规格/数量  读**柜块**槽位（元件NN规格[1..M] / 元件NN数量）
;;     · 图签行        读模型空间独立 TEXT（plt:tbscan / tbpool / tbmap 反查）
;;   分段：按槽号回绕切段（见下面「段信息说明」），第 si 段 <-> 从左到右第 si
;;   枚表头块 —— 箱变两段完整还原成两条表头行 + 各自元件。
;;   元件行【不写槽号】：PLT 按「名称+型号」认槽，顺序不参与定位，所以省掉
;;   槽号也能回灌得一模一样，且与网页生成器写回的格式对齐。
;;   多行规格（元件NN规格1..M，XBT 加过行高）：按行拼接，行间补一个空格。
;;   全程 ssget / entget，**不做任何 entmod**，可在对话框里安全跑。
;; ================================================================

;; 导出摘要 / 失败原因（czt:dump 顺带写，给界面与回包用）
(setq *czt:dump-msg* "")

;; 柜表 -> ((x 柜号 图元名) ...) 按 x 升序（左 -> 右 = 图上的段顺序）
(defun czt:dump-cabs (cabl / out ce x)
  (setq out nil)
  (foreach c cabl
    (setq ce (cdr c) x (car (cdr (assoc 10 (entget ce)))))
    (if (numberp x) (setq out (cons (list x (car c) ce) out)))
  )
  (vl-sort out '(lambda (a b) (< (car a) (car b))))
)

;; 段信息说明（2026-09-24 二次修正）：
;;   先前那句「段边界在图上不可恢复」是**错的**。判段的真依据是**槽号回绕**：
;;   正向 plt:planseg 给每段独立从第 1 槽起编号（高压段 G1 占 1-3、G2 占 4-5、
;;   BYQ1 占 6；低压段 D1 又从 1 重来占 1-2、D2 占 3），所以只要某柜的最小槽号
;;   <= 前面见过的最大槽号，就是回绕 = 新段开始。
;;   段序 = 从左到右，第 si 段 <-> 从左到右第 si 枚表头块 —— 两段箱变因此能
;;   **完整还原**成两条表头行 + 各自元件（含低压柜自己的名称/型号）。
;;   柜块之间确实没有几何间隙，但那已经不需要了。

;; 取一个槽的规格：有多行标签（元件NN规格1..M）就 1..M 拼回来，否则读单行标签。
;;   行间补一个空格 —— wrap 拆行时会把断点处的空白 trim 掉，拼回来只能近似
;;   （只有超宽被拆行的规格才走这条路，普通规格不受影响）
;; 表头块表 -> ((x 属性表) ...) 按 x 升序（左 -> 右 = 段序）
;;   plt:scan 的表头表元素是**图元名**（plt:hsort 把 x 丢了），所以在这里自己取 x。
(defun czt:dump-hs (hdrl / out h x)
  (setq out nil)
  (foreach h hdrl
    (setq x (car (cdr (assoc 10 (entget h)))))
    (if (numberp x) (setq out (cons (list x (plt:atts h)) out)))
  )
  (vl-sort out '(lambda (a b) (< (car a) (car b))))
)

;; 本柜【有数据的槽号】（规格或数量至少一个非空），升序
;;   空槽不出行 —— 生成器写回的清单里就没有空元件行
(defun czt:dump-slots (atts / out mx k sp qt)
  (setq out nil mx (plt:slotmax atts))
  (foreach k (plt:seq 1 mx)
    (setq sp (czt:dump-spec atts k))
    (setq qt (plt:val atts (plt:tagk k "数量")))
    (if (not (and (= (czt:flat sp) "") (= (czt:flat qt) "")))
      (setq out (cons k out))
    )
  )
  (reverse out)
)

;; 工程号「前缀 + 日期」成品 -> (前缀 日期)
;;   plt:tbproj 本来就是 strcat 两段成品的，所以拆开再拼回**值不变**。
;;   只认尾部 10 位 YYYY-MM-DD，或 8 位 20 开头的 YYYYMMDD；认不出就整串当前缀。
(defun czt:dump-pno (s / n d t10 t8)
  (setq s (if s s "") n (strlen s) d nil)
  (if (>= n 10)
    (progn
      (setq t10 (substr s (- n 9)))
      (if (and (= (substr t10 5 1) "-") (= (substr t10 8 1) "-")
               (plt:num (substr t10 1 4)) (plt:num (substr t10 6 2))
               (plt:num (substr t10 9 2)))
        (setq d t10)
      )
    )
  )
  (if (and (null d) (>= n 8))
    (progn
      (setq t8 (substr s (- n 7)))
      (if (and (plt:num t8) (= (substr t8 1 2) "20")) (setq d t8))
    )
  )
  (if d (list (substr s 1 (- n (strlen d))) d) (list s ""))
)

;; 柜表 -> 分段 ((柜 ...) ...)，段序 = 从左到右
;;   段内槽号是**全局连续**的：G1 占 1-3、G2 占 4-5、BYQ1 占 6；第二段 D1 又从 1
;;   重来占 1-2、D2 占 3。所以「本柜最小槽号 <= 前面见过的最大槽号」= 槽号回绕
;;   = 新段开始。这条与正向 plt:planseg 正好互逆（那边是清单里一条表头行切一段）。
;;   ★ 新段必须把 mx 归零 —— 否则第二段之后每台柜都会被当成又一段。
;;   柜块之间没有几何间隙 —— 判段不靠几何，靠槽号。
(defun czt:dump-segs (cabs / out cur mx ks mi k)
  (setq out nil cur nil mx 0)
  (foreach c cabs
    (setq ks (czt:dump-slots (plt:atts (nth 2 c))))
    (if (null ks)
      (setq cur (append cur (list c)))
      (progn
        (setq mi (apply 'min ks))
        (if (and cur (> mi mx))
          (setq cur (append cur (list c)))
          (progn
            (if cur (setq out (append out (list cur))))
            (setq cur (list c) mx 0)
          )
        )
        (foreach k ks (if (> k mx) (setq mx k)))
      )
    )
  )
  (if cur (setq out (append out (list cur))))
  out
)

(defun czt:dump-spec (atts k / m n a i v s)
  (setq m 0)
  (foreach a atts
    (setq n (plt:specno (car a) k))
    (if (> n m) (setq m n))
  )
  (if (> m 0)
    (progn
      (setq s "")
      (foreach i (plt:seq 1 m)
        (setq v (plt:val atts (plt:tagk k (strcat "规格" (itoa i)))))
        (if (and v (/= v ""))
          (setq s (if (= s "") v (strcat s " " v)))
        )
      )
      s
    )
    (progn
      (setq v (plt:val atts (plt:tagk k "规格")))
      (if v v "")
    )
  )
)

;; 图签：key -> 文字内容
(defun czt:dump-tv (m key / p)
  (setq p (assoc key m))
  (if p (plt:tbg (cdr p)) "")
)

;; 图签 -> (柜型 图名 图号 工程号)；4 格全空 / 找不到图签块 -> nil
;;   工程号格图上存的是**拼好的成品**（前缀 + 日期），导回来当前缀用、日期段
;;   留空 -> 再出图时照拼，值不变
;; 图签 -> (柜型 图名 图号 工程号前缀 日期)；5 段全空 / 找不到图签块 -> nil
;;   图上「工程号」格存的是 plt:tbproj 拼好的成品（前缀+日期），这里拆回两段，
;;   好跟网页生成器写回的 `图签|柜型|图名|图号|前缀|日期` 对上。
(defun czt:dump-title ( / refs r tx ty pool m o pr)
  (setq refs (plt:tbscan))
  (if (null refs)
    nil
    (progn
      (setq r (car refs) tx (cadr r) ty (caddr r))
      (setq pool (plt:tbpool tx ty))
      (setq m (plt:tbmap pool tx ty))
      (setq o (list (czt:dump-tv m "product") (czt:dump-tv m "title")
                    (czt:dump-tv m "code")))
      (setq pr (czt:dump-tv m "project"))
      (setq o (append o (czt:dump-pno pr)))
      (if (and (= (nth 0 o) "") (= (nth 1 o) "") (= (nth 2 o) "")
               (= (nth 3 o) "") (= (nth 4 o) ""))
        nil o)
    )
  )
)

;; 一行：段间用 | 连，不足 n 段补空（空段有意义，PLT 靠位置认字段）
(defun czt:dump-line (lst n / out i v)
  (setq out "" i 0)
  (foreach v lst
    (setq i (1+ i))
    (setq out (strcat out (if (= i 1) "" "|") (if v v "")))
  )
  (while (< i n)
    (setq out (strcat out "|") i (1+ i))
  )
  out
)

;; ----------------------------------------------------------------
;; 主入口：图纸 -> 清单文本（CRLF 分行）。没数据返回 nil，原因在 *czt:dump-msg*
;; ----------------------------------------------------------------
;; ----------------------------------------------------------------
;; 主入口：图纸 -> 清单文本（CRLF 分行）。没数据返回 nil，原因在 *czt:dump-msg*
;;   产物与网页生成器写回的清单**同构**：图签行在最前，每段一条表头行，
;;   柜头行 + 该柜元件行（名称|型号|规格|数量，无槽号，空槽不出行）。
;; ----------------------------------------------------------------
(defun czt:dump ( / NL sc cabl hdrl have cabs hs segs tb txt ncomp nseg
                    si seg hp hatt atts fs ks k nm md sp qt)
  (setq NL (strcat (chr 13) (chr 10)))
  (setq sc (plt:scan))
  (setq cabl (car sc) hdrl (cadr sc) have (caddr sc))
  (cond
    ((and (null cabl) (null hdrl))
     (setq *czt:dump-msg* "图上既没柜块也没表头块（先 PGT / XBT 铺图）。")
     nil)
    ((null cabl)
     (setq *czt:dump-msg* (strcat "图上没找到柜块（柜块要有「" *plt:tag-cab* "」标签）。"))
     nil)
    ((null hdrl)
     (setq *czt:dump-msg* (strcat "图上没找到表头块（表头要有「" *plt:tag-hdr* "」标签）。"))
     nil)
    (T
     (setq cabs (czt:dump-cabs cabl))
     (setq hs (czt:dump-hs hdrl))
     (setq segs (czt:dump-segs cabs))
     (setq nseg (length segs))
     (setq txt "" ncomp 0)
     ;; 图签行【放最前】—— 与网页生成器写回的清单同序
     (setq tb (czt:dump-title))
     (if tb (setq txt (strcat txt (czt:dump-line (append (list "图签") tb) 6) NL)))
     (setq si 0)
     (foreach seg segs
       (setq si (1+ si))
       ;; 表头行：第 si 段 <-> 从左到右第 si 枚表头块
       ;;   （正向 plt:maps pls hi 写的就是这个对应，这里取反）
       (setq hp (nth (1- si) hs) hatt (if hp (cadr hp) nil))
       (setq txt (strcat txt (czt:dump-line
                    (list "表头"
                          (if hatt (plt:val hatt *plt:tag-hdr*) "")
                          (if hatt (plt:val hatt "电压等级") "")) 3) NL))
       (foreach c seg
         (setq atts (plt:atts (nth 2 c)))
         ;; 柜头行：@柜号 | 柜用途 | 柜型 | 柜尺寸 | 容量功率 | 分支电流 | 备注
         (setq fs (list (strcat "@" (nth 1 c))))
         (foreach f (plt:cabfields) (setq fs (append fs (list (plt:val atts f)))))
         (setq txt (strcat txt (czt:dump-line fs 7) NL))
         ;; 元件行：名称 | 型号 | 规格 | 数量（**无槽号**）
         ;;   名称/型号 <- 本段表头块槽位；规格/数量 <- 本柜槽位；空槽不出行。
         ;;   PLT 回灌是按「名称+型号」认槽的，顺序不参与定位，所以省掉槽号照样对得上。
         (foreach k (czt:dump-slots atts)
           (setq nm (if hatt (plt:val hatt (plt:tagk k "名称")) ""))
           (setq md (if hatt (plt:val hatt (plt:tagk k "型号")) ""))
           (setq sp (czt:dump-spec atts k))
           (setq qt (plt:val atts (plt:tagk k "数量")))
           (setq txt (strcat txt (czt:dump-line (list nm md sp qt) 4) NL))
           (setq ncomp (1+ ncomp))
         )
       )
     )
     (setq *czt:dump-msg*
       (strcat "段 " (itoa nseg) " / 柜 " (itoa (length cabs))
               " 台 / 表头 " (itoa (length hdrl)) " 枚 / 元件 " (itoa ncomp) " 条"
               (if tb " / 图签已带" " / 无图签")))
     txt
    )
  )
)

;; 图纸 -> 清单 -> 剪贴板（返回给人看的回包字符串）
(defun czt:dumpclip ( / tx ok)
  (setq tx (czt:dump))
  (if (null tx)
    (strcat "[CZT] 图上没扫到可导出的数据 —— " *czt:dump-msg*)
    (progn
      (setq ok (czt:clip-set tx))
      (if ok
        (strcat "[CZT] 已把图上数据导出成清单并写回剪贴板（" *czt:dump-msg* "）。"
                SEP "      格式与 CZT / PLT 吃的清单一致，直接粘回网页生成器也能再编辑。")
        (strcat "[CZT] 导出成功但写剪贴板失败（PowerShell 那条路没走通）。"
                SEP "      文本没丢：命令行执行 (czt:dump) 可直接取到。"))
    )
  )
)

;; 命令行版：图纸 -> 清单 -> 剪贴板（对话框外重试 / 脚本调用）
(defun czt:cur-clip ( / tx)
  (setq tx (czt:dump))
  (if tx (czt:clip-set tx) nil)
)

;; 把对话框上「判型 / 预演 / 清图」三组控件拼成 czt:fl 能识别的 mode 串
;; ----------------------------------------------------------------
;; 对话框开着时禁止出图（硬保护）
;;   实测（2026-09-24）：DCL 对话框处于打开状态时执行出图会卡死整个 CAD ——
;;   PGT/XBT/PLT 内部大量 (command "_.INSERT" …) / (command "_.ZOOM" …)，
;;   而对话框打开时命令行输入被 DCL 消息循环接管，command 取不到输入 →
;;   主线程死等 → 界面完全无响应，只能杀进程。
;;   所以：按钮回调里只「取数据 + 校验 + 关对话框」，
;;         真正的出图统一放到 start_dialog 返回之后（czt:ui-exec）。
;; ----------------------------------------------------------------
(setq *czt:dcl* nil)
(setq *czt:ui-job* nil)

;; 「当前清单」：最近一次加载成功的那份，形如 (来源 文本)
;;   来源 = "剪贴板" 或 txt 的文件名（不含扩展名）
;;   文本 = 原文，字节级照搬，不加工
;;   写回剪贴板按钮就取它。程序级状态，跨对话框保留（重新 load 才清）。
(setq *czt:ui-cur* nil)

(defun czt:dcl-open? () (and (boundp '*czt:dcl*) *czt:dcl*))

;; 取控件值并兜底：get_tile 对容器/不存在的 key 会返 nil，
;;   （AutoLISP 无 stringp 保护会直接崩「参数类型错误: stringp nil」）
(defun czt:tile (k / v)
  (setq v (get_tile k))
  (if (= (type v) (quote STR)) v "")
)

(defun czt:ui-flags ( / ms fl)
  ;; 判型：radio_column 的 key 取不到值，必须读 radio_button 自己的 key
  (setq ms (cond
             ((= (czt:tile "m_kyn28") "1") "kyn28")
             ((= (czt:tile "m_xbw")   "1") "xbw")
             (T "")
           ))
  (setq fl ms)
  (if (= (czt:tile "dry")  "1") (setq fl (strcat fl " dry")))
  (if (= (czt:tile "wipe") "1") (setq fl (strcat fl " wipe")))
  fl
)

;; 把回包（多行文本）铺进对话框的日志列表
(defun czt:ui-log (s / lns x)
  (setq lns (plt:lines (czt:flat s)))
  (start_list "log")
  (foreach x lns (add_list x))
  (end_list)
)

;; 「粘贴剪贴板清单 → 一键出图」按钮
;;   czt:okp 已经是判"清单像不像样"的现成标准（找「表头」或「图签」关键字，
;;   跟 czt:readfile 判文件编码用的是同一条规则）——这里直接拿来先做一次
;;   粘贴内容的形态检查，能在跑之前就拦住"复制错了/忘了点写回"这类误粘贴，
;;   给出比"跑到一半才报错"更直接的提示。
;;   箱变/KYN28 两个网页生成器的"写回"按钮本就是照 czt 这套格式拼的文本
;;   （图签/表头 用 | 分隔、柜头行 @ 开头、元件行 名称|型号|规格|数量、
;;   末尾可能带一段 # 开头的槽位顺序核对块），czt:okp 通不过基本就是
;;   粘贴的不是这两个工具"写回"出来的内容。
(defun czt:ui-pickclip ( / tx)
  (setq tx (czt:clip))
  (cond
    ((null tx)
     (czt:ui-log "[CZT] 剪贴板里没有文本 —— 先在生成器网页里点「写回」，再回来点这个按钮。"))
    ((not (czt:okp tx))
     (czt:ui-log (strcat "[CZT] 剪贴板里的内容不像清单（没找到「表头」或「图签」关键字）。" SEP
                         "      确认已经在箱变/KYN28 生成器网页上点了「写回」（会自动复制到剪贴板），"
                         "再回来点这个按钮。")))
    (T
     ;; 记下「当前清单」（写回剪贴板按钮用）；只记任务，立刻关对话框 ——
     ;; 出图必须等对话框关掉之后再做（见文件头注释）
     (setq *czt:ui-cur* (list "剪贴板" tx))
     (setq *czt:ui-job* (list "text" tx (czt:ui-flags)))
     (done_dialog 1))
  )
  (princ)
)

;; 「改从 TXT 文件读取…」按钮（旧的选文件流程，留作备用入口）
(defun czt:ui-pickfile ()
  ;; 选文件也是模态（getfiled），同样放到对话框关掉之后，避免两种模态打架
  (setq *czt:ui-job* (list "file" nil (czt:ui-flags)))
  (done_dialog 2)
  (princ)
)

;; 刷新状态行：报图上实况（导出按钮取的就是图上数据）
(defun czt:ui-refresh ( / sc)
  (setq sc (plt:scan))
  (set_tile "curinfo"
    (strcat "图上：柜 " (itoa (length (car sc)))
            " 台 · 表头 " (itoa (length (cadr sc)))
            " 枚 · 槽 " (itoa (caddr sc))))
)

;; 「从图纸属性块导出清单 -> 剪贴板」按钮
;;   扫当前图纸的属性块（柜块 / 表头块）与图签 TEXT，按 CZT 清单格式原样
;;   拼回来写进剪贴板 —— 全程只读（ssget/entget），不动图、不碰命令行，
;;   所以能直接放在对话框回调里跑（与出图那种必须挪出对话框的动作不同）。
(defun czt:ui-saveclip ( / )
  (czt:ui-log (czt:dumpclip))
  (czt:ui-refresh)
  (princ)
)

;; 对话框关闭后执行真正的动作 —— 这里才是能安全跑 command 的地方
(defun czt:ui-exec ( / job kind tx f r)
  (setq job *czt:ui-job*)
  (setq *czt:ui-job* nil)
  (if job
    (progn
      (setq kind (car job))
      (if (= kind "text")
        (czt:text (nth 1 job) (nth 2 job))
        (progn
          (setq f (getfiled "选清单文件（ANSI/GBK 或 UTF-8 的 txt）" "" "txt" 0))
          (if (or (null f) (= f ""))
            (princ "\n[CZT] 取消了，没选文件。")
            (progn
              ;; 顺手留一份原文当「当前清单」（编码自适应与 czt:go 同口径）
              (setq tx (czt:readfile f))
              (if (czt:okp tx) (setq *czt:ui-cur* (list (vl-filename-base f) tx)))
              (czt:go f (nth 2 job))
            )
          )
        )
      )
    )
  )
  (princ)
)

;; 运行时把对话框描述写成一个临时 .dcl 文件（用完即删）
(defun czt:ui-dcl ( / f h)
  (setq f (vl-filename-mktemp "czt" nil ".dcl"))
  (setq h (open f "w"))
  (if h
    (progn
      (write-line "czt_dlg : dialog {" h)
      (write-line "  label = \"属性块 - 一键出图（CZT）\";" h)
      (write-line "  : boxed_column {" h)
      (write-line "    label = \"第 1 步 · 准备清单\";" h)
      (write-line "    : text { label = \"在「箱变生成器」或「KYN28 生成器」网页上点一下「写回」按钮，\"; }" h)
      (write-line "    : text { label = \"它会自动把清单文本复制到剪贴板（本机也认手工整理的同格式文本）。\"; }" h)
      (write-line "  }" h)
      (write-line "  : boxed_row {" h)
      (write-line "    label = \"第 2 步 · 出图方式\";" h)
      (write-line "    : radio_column {" h)
      (write-line "      label = \"判型\";" h)
      (write-line "      : radio_button { key = \"m_auto\";  label = \"自动判型（推荐）\"; }" h)
      (write-line "      : radio_button { key = \"m_kyn28\"; label = \"强制 KYN28\"; }" h)
      (write-line "      : radio_button { key = \"m_xbw\";   label = \"强制箱变两段\"; }" h)
      (write-line "    }" h)
      (write-line "    : column {" h)
      (write-line "      : toggle { key = \"dry\";  label = \"只预演，不写图\"; }" h)
      (write-line "      : toggle { key = \"wipe\"; label = \"先清空当前空间再重铺（危险）\"; }" h)
      (write-line "    }" h)
      (write-line "  }" h)
      (write-line "  : boxed_row {" h)
      (write-line "    label = \"第 3 步 · 一键执行\";" h)
      (write-line "    : button { key = \"runclip\"; label = \"粘贴剪贴板清单 → 一键出图\"; is_default = true; width = 32; fixed_width = true; }" h)
      (write-line "    : button { key = \"runfile\"; label = \"改从 TXT 文件读取…\"; width = 20; fixed_width = true; }" h)
      (write-line "  }" h)
      (write-line "  : boxed_row {" h)
      (write-line "    label = \"数据回流（图上数据 → 剪贴板）\";" h)
      (write-line "    : button { key = \"saveclip\"; label = \"从图纸属性块导出清单 → 剪贴板\"; width = 34; fixed_width = true; }" h)
      (write-line "    : text { key = \"curinfo\"; label = \"图上：—\"; width = 28; }" h)
      (write-line "  }" h)
      (write-line "  : boxed_column {" h)
      (write-line "    label = \"回包 / 日志\";" h)
      (write-line "    : list_box { key = \"log\"; height = 14; width = 62; }" h)
      (write-line "  }" h)
      (write-line "  spacer;" h)
      (write-line "  : button { key = \"closebtn\"; label = \"关闭\"; is_cancel = true; width = 12; fixed_width = true; }" h)
      (write-line "}" h)
      (close h)
      f
    )
    nil
  )
)

;; 打开交互入口：一次性粘贴（剪贴板）或选文件，点按钮直接出图
(defun czt:ui ( / dclf dcl_id)
  (setq dclf (czt:ui-dcl))
  (cond
    ((null dclf)
     (princ (strcat SEP "[CZT] 临时 DCL 文件写不出来，改用命令行流程：(czt:go \"路径\")。")))
    (T
     (setq dcl_id (load_dialog dclf))
     (cond
       ((< dcl_id 0)
        (princ (strcat SEP "[CZT] DCL 加载失败，改用命令行流程：(czt:go \"路径\")。")))
       ((not (new_dialog "czt_dlg" dcl_id))
        (princ (strcat SEP "[CZT] 对话框初始化失败。"))
        (unload_dialog dcl_id))
       (T
        (set_tile "m_auto" "1")
        (action_tile "runclip"  "(czt:ui-pickclip)")
        (action_tile "runfile"  "(czt:ui-pickfile)")
        (action_tile "saveclip" "(czt:ui-saveclip)")
        (action_tile "closebtn" "(done_dialog)")
        (czt:ui-refresh)
        (setq *czt:ui-job* nil)
        (setq *czt:dcl* T)
        (start_dialog)
        (setq *czt:dcl* nil)
        (unload_dialog dcl_id)
        (czt:ui-exec))
     )
     (if (findfile dclf) (vl-catch-all-apply 'vl-file-delete (list dclf)))
    )
  )
  (princ)
)

