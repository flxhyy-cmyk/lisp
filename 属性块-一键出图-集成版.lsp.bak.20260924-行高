;; CZT：打开交互入口 —— 粘贴剪贴板清单，或改选 txt 文件，点按钮一键出图
(defun c:CZT ( / )
  (czt:ensure)
  (czt:ui)
  (princ)
)

(princ (strcat SEP "属性块-一键出图.lsp 已加载（集成单文件版）。"
               SEP "  命令 CZT          打开交互入口：粘贴剪贴板清单 / 选 txt 文件，一键出图"
               SEP "  (czt:auto \"路径\")   (czt:go \"路径\" \"kyn28\"/\"xbw\"/\"dry\"/\"wipe\"/nil)   (czt:dry \"路径\")   (czt:text \"清单文本\" nil)"
               SEP "  转发：czt:slot 改槽 / czt:row 行高 / czt:title 图签 / czt:add 元件 / czt:width 柜宽 / czt:swap 换槽"
               SEP "  回流：界面「从图纸属性块导出清单 → 剪贴板」按钮 / (czt:dump) 取文本 / (czt:dumpclip) 导出并写剪贴板"))
(princ)
