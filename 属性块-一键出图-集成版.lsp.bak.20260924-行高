(defun plt:run (tx)     (plt:go tx T))
(defun plt:dry (tx)     (plt:go tx nil))
(defun plt:need (tx / ps cabs sd)
  (setq ps (plt:parse tx) cabs (caddr ps) sd (nth 6 ps))
  (if (> (length (plt:segs cabs)) 1)
    (plt:needseg (plt:planseg cabs sd))
    (cadr (plt:plan cabs (plt:sdef-at sd 1)))
  )
)
(defun plt:runfile (f)  (plt:go (plt:readfile f) T))
(defun plt:dryfile (f)  (plt:go (plt:readfile f) nil))
;; 只重填图签（柜数据不动）：柜型|图名|图号|工程号前缀|日期
(defun plt:titlerun (s) (cadr (plt:tbgo (plt:pad (plt:fields s) 5) T)))
(defun plt:titledry (s) (cadr (plt:tbgo (plt:pad (plt:fields s) 5) nil)))

(defun c:PLT ( / f tx r)
  (setq f (getstring T "\n清单文件路径（ANSI/GBK 的 txt，直接回车取消）: "))
  (if (= (plt:trim f) "")
    (princ "\n取消了，什么也没做。")
    (progn
      (setq tx (plt:readfile f))
      (if (null tx)
        (princ (strcat "\n读不到这个文件：" f))
        (progn
          (setq r (plt:go tx T))
          (princ (strcat SEP r))
        )
      )
    )
  )
  (princ)
)

