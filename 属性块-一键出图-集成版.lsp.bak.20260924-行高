;; 列出本排 → 问增减 → 执行
(defun gkc:go (e row / k r x n)
  (if (null row)
    (princ "\n没认到本排的槽位属性块，退出。")
    (progn
      (princ "\n【本排将影响的块】")
      (setq r 0)
      (foreach x row
        (setq r (1+ r))
        (princ (strcat "\n   " (itoa r) ") " (cdr (assoc 2 (entget x)))
                      "   柜号=" (gkc:trim (gkc:tag x "柜号"))))
      )
      (princ (strcat "\n   共 " (itoa (length row)) " 个块。"))
      (initget "A D X")
      (setq k (getkword "\n[增(A) / 减(D) / 退出(X)] <增>: "))
      (cond
        ((= k "X") (princ "\n已退出，图没动。"))
        (T
         (setq n (getint (strcat "\n" (if (= k "D") "减" "增") "几个槽 <1>: ")))
         (setq n (if (and n (> n 0)) n 1))
         (if (= k "D") (gkc:del e row n) (gkc:add e row n))
        )
      )
    )
  )
)

(defun c:GKC ( / ss e row x i)
  (princ "\n[GKC] 柜排槽位增减 —— 在本排行区底部一次增 / 减 N 个标准槽位行")
  (princ "\n       作用范围：本排【全部】属性块，含表头块。点一个块 → 自动认段。")
  (princ "\n       也可以一次多选 / 框选本排若干块 —— 那就完全按你选的来，不再自动认。")
  (princ "\n       （为什么要确认范围：高压排与低压排非槽属性完全一样，槽数一变就可能被认成一段。）")
  (princ "\n       增(A)：新槽落在行区最底 → 备注行 / 容量功率行整体下移 N 个行距，块底向下长。")
  (princ "\n       减(D)：删掉行区最底 N 槽 → 备注行 / 容量功率行整体上移 N 个行距，块底向上收。")
  (princ "\n       柜顶（顶部数据容器）与已有槽位一律不动；表头块与柜块始终对齐。")
  (princ "\n       减的闸门：本排任意一个块、最底 N 槽任意一个属性有数据 → 整次拒绝，一个块都不动。")
  (princ "\n       块定义会克隆成新名（原名-柜号）再改，原定义原封不动，别的排不受影响。")
  (princ "\n       本排参照会重造一遍（句柄会变）—— 本机 CAD 没法给旧参照补属性，只有重插才带得出来。")
  (princ "\n       执行前会把将影响的块列出来，看清了再动手。")
  (princ "\n       被导入工具调用时走另一条口（按句柄直达，并自动按几何补齐整行）：")
  (princ "\n           (gkc:plan \"句柄,句柄,...\" N)    只读清单，图不动")
  (princ "\n           (gkc:expand \"句柄,句柄,...\" N)  执行")
  (princ "\n选择本排任意一个柜块或表头块（可多选）<退出>: ")
  (setq ss (ssget '((0 . "INSERT"))))
  (cond
    ((null ss) (princ "\n没选到块，退出。"))
    ((> (sslength ss) 1)
     ;; 多选 = 显式指定本排
     (setq row nil i 0)
     (while (< i (sslength ss))
       (setq x (ssname ss i))
       (if (gkc:maxslot (cdr (assoc 2 (entget x))))
         (setq row (cons x row))
         (princ (strcat "\n  略过（无槽位属性）：" (cdr (assoc 2 (entget x))))))
       (setq i (1+ i))
     )
     (setq row (reverse row))
     (gkc:go (car row) row)
    )
    (T
     (setq e (ssname ss 0))
     (gkc:go e (gkc:row e (gkc:snapshot)))
    )
  )
  (princ)
)

